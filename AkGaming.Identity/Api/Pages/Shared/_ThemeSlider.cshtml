<div class="theme-slider" data-theme-picker role="radiogroup" aria-label="Theme">
  <span class="theme-slider-thumb" aria-hidden="true"></span>
  <button type="button" class="theme-slider-option" data-theme-value="system" role="radio" aria-checked="false" title="Use system theme">
    <span class="theme-icon bi bi-display" aria-hidden="true"></span>
    <span class="visually-hidden">Use system theme</span>
  </button>
  <button type="button" class="theme-slider-option" data-theme-value="light" role="radio" aria-checked="false" title="Use light theme">
    <span class="theme-icon bi bi-sun" aria-hidden="true"></span>
    <span class="visually-hidden">Use light theme</span>
  </button>
  <button type="button" class="theme-slider-option" data-theme-value="dark" role="radio" aria-checked="false" title="Use dark theme">
    <span class="theme-icon bi bi-moon" aria-hidden="true"></span>
    <span class="visually-hidden">Use dark theme</span>
  </button>
</div>
