@page "/account/email-change"
@model AkGaming.Identity.Api.Pages.Account.EmailChangeModel
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>AKG Identity | Email Change</title>
  <link rel="icon" type="image/png" href="/ui/AkGaming_Identity.png" />
  <link rel="stylesheet" href="/ui/akgaming-base-theme.css" />
  <link rel="stylesheet" href="/ui/baseStyles.css" />
  <link rel="stylesheet" href="/ui/styles.css" />
  <script src="/ui/common.js" defer></script>
</head>
<body>
  <main class="shell">
    <div class="topbar">
      <partial name="_ThemeSlider" />
    </div>
    <div class="brand">
      <img src="/ui/AkGaming_Identity.png" alt="@ClubConstants.Organization.ShortName" />
      <div class="brand-title">@ClubConstants.Organization.ShortName <span class="identity">Identity</span></div>
    </div>
    <h1>Confirm Email Change</h1>
    @if (Model.Completed)
    {
      <div class="status ok" role="status">Your email address has changed and is verified. Sign in again using your new address or linked Discord account.</div>
      <a class="button primary" asp-page="/Account/Login">Sign In</a>
    }
    else
    {
      <p class="sub">Confirm that you want to use this mailbox for your AK Gaming Identity account. Your current address remains active until you confirm.</p>
      <form method="post" class="identity-form">
        <input asp-for="Token" type="hidden" />
        <button class="primary" type="submit">Confirm Email Change</button>
      </form>
      @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
      {
        <div class="status error" role="alert">@Model.ErrorMessage</div>
      }
      <a class="switch" asp-page="/Account/Manage">Back to Account</a>
    }
  </main>
</body>
</html>
