@page "/account/password-reset"
@model AkGaming.Identity.Api.Pages.Account.PasswordResetModel
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>AKG Identity | Password Reset</title>
  <link rel="icon" type="image/png" href="/ui/AkGaming_Identity.png" />
  <link rel="stylesheet" href="/ui/akgaming-base-theme.css" />
  <link rel="stylesheet" href="/ui/baseStyles.css" />
  <link rel="stylesheet" href="/ui/styles.css" />
  <script src="/ui/common.js" defer></script>
</head>
<body>
  <main class="shell">
    <div class="topbar">
      <partial name="_ThemeSlider" />
    </div>
    <div class="brand">
      <img src="/ui/AkGaming_Identity.png" alt="@ClubConstants.Organization.ShortName" />
      <div class="brand-title">@ClubConstants.Organization.ShortName <span class="identity">Identity</span></div>
    </div>
    <h1>Password Reset</h1>
    <p class="sub">Request a reset link or set a new password with the token from your email.</p>

    <form method="post" asp-page-handler="RequestReset" class="identity-form">
      <input asp-for="ReturnUrl" type="hidden" />
      <div class="ui-field">
        <label asp-for="Email">Email</label>
        <input asp-for="Email" type="email" autocomplete="email" required />
      </div>
      <button class="primary" type="submit">Send Reset Email</button>
    </form>

    <form method="post" asp-page-handler="ResetPassword" class="identity-form">
      <input asp-for="ReturnUrl" type="hidden" />
      <div class="ui-field">
        <label asp-for="Token">Reset Token</label>
        <input asp-for="Token" autocomplete="off" spellcheck="false" required />
      </div>
      <div class="ui-field">
        <label asp-for="Password">New Password</label>
        <input asp-for="Password" type="password" autocomplete="new-password" required minlength="8" />
      </div>
      <button class="secondary" type="submit">Reset Password</button>
    </form>

    <a class="switch" asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">Back to sign in</a>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
      <div class="status ok">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
      <div class="status error">@Model.ErrorMessage</div>
    }
  </main>
</body>
</html>
