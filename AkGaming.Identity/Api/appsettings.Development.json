{
  "Database": {
    "Provider": "Sqlite"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Smtp": {
    "Enabled": false
  },
  "App": {
    "PublicBaseUrl": "https://localhost:7288"
  },
  "OpenIddict": {
    "Issuer": "https://localhost:7288",
    "Applications": [
      {
        "ClientId": "akgaming-management-frontend",
        "ClientSecret": "development-management-client-secret",
        "DisplayName": "AK Gaming Management Frontend",
        "ConsentType": "implicit",
        "ClientType": "confidential",
        "RequirePkce": true,
        "RedirectUris": [
          "https://localhost:7216/signin-oidc"
        ],
        "PostLogoutRedirectUris": [
          "https://localhost:7216/signout-callback-oidc"
        ],
        "Scopes": [
          "openid",
          "profile",
          "email",
          "roles",
          "offline_access",
          "management_api"
        ]
      },
      {
        "ClientId": "akgaming-website-cms",
        "ClientSecret": "development-website-cms-client-secret",
        "DisplayName": "AK Gaming Website CMS",
        "ConsentType": "implicit",
        "ClientType": "confidential",
        "RequirePkce": true,
        "RedirectUris": [
          "http://localhost:3000/api/auth/callback/akgaming"
        ],
        "PostLogoutRedirectUris": [
          "http://localhost:3000/cms"
        ],
        "Scopes": [
          "openid",
          "profile",
          "email",
          "roles"
        ]
      },
      {
        "ClientId": "akgaming-management-api",
        "ClientSecret": "development-management-notification-secret",
        "DisplayName": "AK Gaming Management API",
        "ClientType": "confidential",
        "RequirePkce": false,
        "AllowAuthorizationCodeFlow": false,
        "AllowRefreshTokenFlow": false,
        "AllowClientCredentialsFlow": true,
        "Scopes": [ "gamelybot_notifications" ]
      },
      {
        "ClientId": "akgaming-gamelybot",
        "ClientSecret": "development-gamelybot-identity-secret",
        "DisplayName": "GamelyBot",
        "ClientType": "confidential",
        "RequirePkce": false,
        "AllowAuthorizationCodeFlow": false,
        "AllowRefreshTokenFlow": false,
        "AllowClientCredentialsFlow": true,
        "Scopes": [ "identity_discord_links", "management_board_interactions", "management_disbursement_interactions", "identity_audit_summaries", "management_audit_summaries" ]
      }
    ]
  },
  "Bridge": {
    "AllowedRedirectUris": [
      "https://localhost:7216/authentication/callback",
      "http://localhost:5207/authentication/callback"
    ]
  },
  "AllowedHosts": "*"
}
