{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=gamelybot.db"
  },
  "Database": {
    "Provider": "sqlite"
  },
  "Authentication": {
    "Disabled": false
  },
  "OpenIddictValidation": {
    "Issuer": "https://identity.akgaming.de/"
  },
  "NotificationTransport": "discord",
  "Discord": {
    "Token": "",
    "GuildId": "",
    "AdministrationChannelId": "",
    "TreasurerRoleId": "",
    "BoardChannelId": "",
    "BoardRoleId": "",
    "ApplicationPublicKey": ""
  },
  "NotificationRouting": {
    "TreasurerRoleId": "",
    "BoardChannelId": "",
    "BoardRoleId": ""
  },
  "IdentityClient": {
    "BaseUrl": "https://identity.akgaming.de/",
    "TokenEndpoint": "https://identity.akgaming.de/connect/token",
    "ClientId": "akgaming-gamelybot",
    "ClientSecret": "",
    "Scope": "identity_discord_links management_board_interactions",
    "UseAuthentication": true
  },
  "ManagementClient": {
    "BaseUrl": "https://management.akgaming.de/api/"
  },
  "DiscordInteractions": {
    "ValidateSignatures": true,
    "TimeZoneId": "Europe/Berlin",
    "EnableAutomaticReminders": true,
    "ReminderLeadTimeMinutes": 60,
    "ReminderPollIntervalSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
