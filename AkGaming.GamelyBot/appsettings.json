{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=gamelybot.db"
  },
  "Database": {
    "Provider": "sqlite"
  },
  "Authentication": {
    "Disabled": false
  },
  "OpenIddictValidation": {
    "Issuer": "https://identity.akgaming.de/"
  },
  "NotificationTransport": "discord",
  "Localization": {
    "Culture": "en-GB"
  },
  "Discord": {
    "Token": "",
    "GuildId": "",
    "AdministrationChannelId": "",
    "TreasurerRoleId": "",
    "BoardChannelId": "",
    "BoardRoleId": "",
    "ExtendedBoardRoleId": "",
    "SecretaryRoleId": "",
    "HeadOfSportsRoleId": "",
    "MemberRoleId": "",
    "ApplicationPublicKey": ""
  },
  "NotificationRouting": {
    "TreasurerRoleId": "",
    "BoardChannelId": "",
    "BoardRoleId": "",
    "ExtendedBoardRoleId": ""
  },
  "IdentityClient": {
    "BaseUrl": "https://identity.akgaming.de/",
    "TokenEndpoint": "https://identity.akgaming.de/connect/token",
    "ClientId": "akgaming-gamelybot",
    "ClientSecret": "",
    "Scope": "identity_discord_links management_board_interactions identity_audit_summaries management_audit_summaries",
    "UseAuthentication": true
  },
  "ManagementClient": {
    "BaseUrl": "https://management.akgaming.de/api/",
    "FrontendBaseUrl": "https://management.akgaming.de"
  },
  "DiscordInteractions": {
    "ValidateSignatures": true,
    "TimeZoneId": "Europe/Berlin",
    "EnableAutomaticReminders": true,
    "ReminderLeadTimeMinutes": 60,
    "ReminderPollIntervalSeconds": 60
  },
  "AuditSummaries": {
    "EnableWeeklySummary": true,
    "TimeZoneId": "Europe/Berlin",
    "DayOfWeek": "Monday",
    "Hour": 9,
    "PollIntervalMinutes": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
