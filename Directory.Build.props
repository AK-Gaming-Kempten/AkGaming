<Project>
  <PropertyGroup>
    <!-- Server builds do not need workloads; the MAUI host does. -->
    <MSBuildEnableWorkloadResolver Condition="'$(MSBuildProjectName)' != 'AkGaming.Gamenight.Mobile'">false</MSBuildEnableWorkloadResolver>
    <MSBuildEnableWorkloadResolver Condition="'$(MSBuildProjectName)' == 'AkGaming.Gamenight.Mobile'">true</MSBuildEnableWorkloadResolver>
    <!-- Work around static restore graph failures after cross-project moves. -->
    <RestoreUseStaticGraphEvaluation>false</RestoreUseStaticGraphEvaluation>
  </PropertyGroup>
</Project>
