@namespace AkGaming.Core.Components.Auth

<div class="unauthorized-wrapper">
    @if (!string.IsNullOrWhiteSpace(ImageUrl))
    {
        <img class="unauthorized-image" src="@ImageUrl" alt="@ImageAlt" />
    }

    <div class="unauthorized-content">
        @ChildContent
    </div>

    <button class="unauthorized-button" @onclick="Login">
        @LoginText
    </button>
</div>
