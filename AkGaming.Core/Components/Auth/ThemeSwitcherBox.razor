@namespace AkGaming.Core.Components.Auth

<div class="theme-switcher-box">
    <div class="theme-switcher-control @ThemeCssClass" role="radiogroup" aria-label="@AriaLabel">
        <span class="theme-switcher-thumb" aria-hidden="true"></span>
        <button type="button" role="radio" aria-checked="@(_currentTheme == Theme.System)" title="@SystemTitle" @onclick="() => SetTheme(Theme.System)">
            <span class="bi bi-display" aria-hidden="true"></span>
        </button>
        <button type="button" role="radio" aria-checked="@(_currentTheme == Theme.Light)" title="@LightTitle" @onclick="() => SetTheme(Theme.Light)">
            <span class="bi bi-sun" aria-hidden="true"></span>
        </button>
        <button type="button" role="radio" aria-checked="@(_currentTheme == Theme.Dark)" title="@DarkTitle" @onclick="() => SetTheme(Theme.Dark)">
            <span class="bi bi-moon" aria-hidden="true"></span>
        </button>
    </div>
</div>
