<span class="desk-status @Tone"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    @switch (Icon)
    {
        case "check": <circle cx="12" cy="12" r="9" /><path d="m8 12 3 3 5-6" /> break;
        case "cancel": <circle cx="12" cy="12" r="9" /><path d="m9 9 6 6m0-6-6 6" /> break;
        case "payment": <rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 10h18m-5 5h2" /> break;
        default: <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /> break;
    }
</svg>@Text</span>
