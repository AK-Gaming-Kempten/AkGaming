<article class="catering-meal card">
    <CateringIcon Kind="@Item.Icon" />
    <div><h4>@Item.Name</h4><p>@Item.Description</p><strong>@Money(Item.PriceCents)</strong>
        @if (Item.DiscountEligible) { <small>Frühbucherrabatt bis @Money(Math.Min(Item.PriceCents, Item.DiscountOverrideCents ?? DefaultDiscountCents))</small> }
    </div>
    <div class="counter-controls"><button type="button" class="secondary" disabled="@(Quantity == 0)" aria-label="@($"{Item.Name} weniger")" @onclick="() => QuantityChanged.InvokeAsync(Quantity - 1)">−</button><output aria-live="polite">@Quantity</output><button type="button" class="secondary" disabled="@(Quantity >= 100)" aria-label="@($"{Item.Name} mehr")" @onclick="() => QuantityChanged.InvokeAsync(Quantity + 1)">+</button></div>
</article>
