@page "/frontdesk"
<div class="frontdesk-workspace">
    <header class="desk-page-header"><h1>Front Desk</h1><div class="desk-inline-actions"><button class="secondary" @onclick="Load"><span aria-hidden="true">↻</span> Aktualisieren</button>@if (_permissions.Contains(Permissions.Export)) { <ContextMenu AriaLabel="Frontdesk verwalten"><ContextMenuItem Text="CSV exportieren" OnClick="Export" /></ContextMenu> }</div></header>
    @if (_error is not null) { <p class="error" role="alert">@_error</p> }
    @if (_allowed)
    {
        <div class="desk-layout">
            <section class="desk-visitors" aria-label="Besucherliste">
                <div class="desk-search"><label class="visually-hidden" for="desk-search">Besucher suchen</label><input id="desk-search" type="search" @bind="_search" @bind:event="oninput" placeholder="Name oder E-Mail suchen" /><label class="visually-hidden" for="desk-filter">Status</label><select id="desk-filter" @bind="_filter"><option value="">Alle Besucher</option><option value="waiting">Check-in offen</option><option value="checked">Eingecheckt</option><option value="unpaid">Zahlung offen</option><option value="staff">Personal</option><option value="cancelled">Storniert</option></select></div>
                <div class="desk-list-body">
                    @foreach (var r in Filtered)
                    {
                        <button class="visitor-row @(r.Id == _selected ? "selected" : "")" aria-pressed="@(r.Id == _selected)" @onclick="() => _selected = r.Id">@r.Form.LastName, @r.Form.FirstName</button>
                    }
                    @if (!Filtered.Any()) { <p class="muted">Keine passenden Anmeldungen.</p> }
                </div>
                <small class="desk-list-count">@Filtered.Count() Besucher</small>
            </section>
            <div class="desk-detail-area">
                @if (_rows.FirstOrDefault(r => r.Id == _selected) is { } selected)
                {
                    <FrontdeskVisitorDetails @key="selected.Id" Registration="selected" Granted="_permissions" Menu="_menu" Catering="_catering.FirstOrDefault(c => c.RegistrationId == selected.Id)" Changed="Load" />
                }
                else { <section class="desk-empty"><h2>Besucher auswählen</h2><p>Nach Namen suchen, Zahlung prüfen und einchecken.</p></section> }
            </div>
        </div>
        <footer class="desk-summary"><span><strong>@_rows.Count(r => !r.Cancelled)</strong> angemeldet</span><span><strong>@_rows.Count(r => r.CheckedIn)</strong> eingecheckt</span><span><strong>@_rows.Count(r => r.StaffApproved && !r.Cancelled)</strong> Personal</span><button class="desk-summary-link" @onclick="() => _planning = true">Planungsübersicht</button></footer>
    }
</div>
@if (_planning)
{
    <FormDialog Compact="true" Title="Planungsübersicht" OnClose="() => _planning = false"><ChildContent><p>@_rows.Count(r => !r.Cancelled && r.Form.Sockets > 0) Setups · Pizza: @TotalMeals("Pizza") · Döner: @TotalMeals("Döner") · Eis: @TotalIceCream Kugeln</p><p class="muted">Unverbindliche Interessen aus den Anmeldungen. Verbindliche Bestellungen stehen in der Catering-Verwaltung.</p></ChildContent><Footer><button class="secondary" @onclick="() => _planning = false">Schließen</button></Footer></FormDialog>
}
