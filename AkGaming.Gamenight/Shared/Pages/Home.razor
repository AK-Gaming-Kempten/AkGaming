@page "/"
<PageTitle>Game Night · AK Gaming</PageTitle>
<p class="eyebrow">GAMING · KARAOKE · COMMUNITY</p>
<h1>@(_active?.Event?.Name ?? "Deine nächste Game Night")</h1>
@if (_error is not null) { <p role="alert" class="error">@_error</p> }
@if (_active is null) { <p role="status">Game Night wird geladen …</p> }
@if (_active is { Event: null }) { <p>Aktuell ist keine Game Night zur Anmeldung ausgewählt.</p> }
@if (_active?.Event is { } gameNight)
{
    <div class="signup-layout">
        <aside class="card event-info">
            <h2>Ein Abend. Deine Community.</h2>
            <p>@BerlinTime(gameNight.StartsAt) · @gameNight.Location</p>
            <p class="preserve">@gameNight.Information</p>
            <dl><dt>Frühbucher / mit Setup</dt><dd>@Money(gameNight.EarlyPriceCents) / @Money(gameNight.EarlySetupPriceCents)</dd><dt>Regulär / mit Setup</dt><dd>@Money(gameNight.RegularPriceCents) / @Money(gameNight.RegularSetupPriceCents)</dd><dt>Mitglieder: Frühbucher / regulär</dt><dd>@Money(gameNight.MemberEarlyPriceCents) / @Money(gameNight.MemberRegularPriceCents)</dd></dl>
            <p>Frühbucher bis @BerlinTime(gameNight.EarlyBirdDeadline). Essenswünsche bis @BerlinTime(gameNight.FoodDeadline).</p>
            <p>Anmeldung bis @BerlinTime(gameNight.SignupDeadline). Änderungen bis @BerlinTime(gameNight.EditDeadline), spätestens bis zum Check-in.</p>
            <div class="callout"><strong>Mit deinem Konto hast du mehr davon.</strong><p>Anmeldung bearbeiten oder stornieren und als Mitglied automatisch den Mitgliedstarif erhalten: Wir prüfen dein verknüpftes Mitgliedsprofil und den bezahlten Beitrag in Management. Auch eine Gastanmeldung kannst du später mit derselben verifizierten E-Mail übernehmen.</p><button class="secondary" @onclick="Login">Anmelden / Konto erstellen</button></div>
        </aside>
        <section class="card">
        @if (_receipt is not null) { <h2>Danke!</h2><p role="status">@_receipt</p><a href="/mine">Meine Anmeldung</a> }
        @if (_receipt is null && DateTime.UtcNow <= gameNight.SignupDeadline) { <SignupEditor Form="_form" Busy="_busy" Submit="Submit" /> }
        @if (_receipt is null && DateTime.UtcNow > gameNight.SignupDeadline) { <h2>Anmeldung geschlossen</h2><p>Die Anmeldefrist ist abgelaufen.</p> }
        </section>
    </div>
}
