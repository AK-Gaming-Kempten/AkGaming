{
  "Identity": {
    "Authority": "https://identity.akgaming.de"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Gamenight": "Data Source=gamenight.db"
  },
  "App": {
    "PublicBaseUrl": "https://gamenight.akgaming.de"
  },
  "Management": {
    "BaseUrl": "https://management.akgaming.de/api/",
    "TokenEndpoint": "https://identity.akgaming.de/connect/token",
    "ClientId": "akgaming-gamenight-api",
    "Scope": "management_gamenight_membership"
  },
  "GamelyBot": {
    "Enabled": false,
    "Endpoint": "",
    "TokenEndpoint": "https://identity.akgaming.de/connect/token",
    "ClientId": "akgaming-gamenight-api",
    "Scope": "gamelybot_notifications"
  },
  "Smtp": {
    "Enabled": false,
    "Port": 587,
    "UseSsl": true
  }
}
