FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 3011

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl libgssapi-krb5-2 \
    && rm -rf /var/lib/apt/lists/*

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy everything (monorepo root context)
COPY . .

# Restore solution (note the path!)
RUN dotnet restore "AkGaming.Management/AkGaming.Management.sln"

# Build & publish (note the path!)
RUN dotnet publish "AkGaming.Management/WebApi/AkGaming.Management.WebApi.csproj" \
    -c Release \
    -o /app/publish \
    --no-restore \
    -m:1 \
    /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:3011

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl --fail --silent --show-error --max-time 5 http://127.0.0.1:3011/health || exit 1

ENTRYPOINT ["dotnet", "AkGaming.Management.WebApi.dll"]
