FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy everything (monorepo root context)
COPY . .

# Restore & publish
RUN dotnet restore "AkGaming.Management/Frontend/AkGaming.Management.Frontend.csproj"

RUN dotnet publish "AkGaming.Management/Frontend/AkGaming.Management.Frontend.csproj" \
    -c Release \
    -o /app/publish \
    --no-restore \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl --fail --silent --show-error --max-time 5 http://127.0.0.1:8080/health || exit 1

ENTRYPOINT ["dotnet", "AkGaming.Management.Frontend.dll"]
