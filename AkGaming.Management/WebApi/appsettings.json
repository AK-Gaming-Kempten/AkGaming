{
  "Logging": {
    "LogLevel": {
      "Microsoft.AspNetCore.Mvc": "Debug",
      "Microsoft.AspNetCore.Http.Json": "Debug",
      "Microsoft.AspNetCore.Routing": "Information",
      "Default": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "Provider": "Postgres"
  },
  "OpenIddictValidation": {
    "Issuer": "https://identity.akgaming.de"
  },
  "Notifications": {
    "Endpoint": "",
    "TokenEndpoint": "https://identity.akgaming.de/connect/token",
    "ClientId": "akgaming-management-api",
    "ClientSecret": "",
    "Scope": "gamelybot_notifications",
    "UseAuthentication": true,
    "ManagementFrontendBaseUrl": "https://management.akgaming.de"
  },
  "Smtp": {
    "Enabled": false,
    "Host": "smtp.example.com",
    "Port": 587,
    "UseSsl": true,
    "TimeoutSeconds": 15,
    "Username": "smtp-user",
    "Password": "smtp-password",
    "FromEmail": "no-reply@akgaming.de",
    "FromName": "AK Gaming Management"
  },
  "GeneralMeetings": {
    "DataProtectionKeysPath": "data/general-meeting-keys"
  }
}
