{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=management.db"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "OpenIddictValidation": {
    "Issuer": "https://localhost:7288"
  },
  "Notifications": {
    "Endpoint": "http://localhost:5088/api/notifications",
    "TokenEndpoint": "https://localhost:7288/connect/token",
    "ClientId": "akgaming-management-api",
    "ClientSecret": "development-management-notification-secret",
    "Scope": "gamelybot_notifications",
    "UseAuthentication": false,
    "ManagementBaseUrl": "https://localhost:7216"
  },
  "Dev": {
    "AllowUntrustedLocalCertificates": true
  },
  "Smtp": {
    "Enabled": false,
    "Host": "smtp.example.com",
    "Port": 587,
    "UseSsl": true,
    "TimeoutSeconds": 15,
    "Username": "smtp-user",
    "Password": "smtp-password",
    "FromEmail": "no-reply@akgaming.de",
    "FromName": "AK Gaming Management (Development)"
  }
}
