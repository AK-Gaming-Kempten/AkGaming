@using AkGaming.Management.Modules.MemberManagement.Contracts.Enums

<div class="dialog-backdrop" role="presentation">
    <section class="payment-dialog" role="dialog" aria-modal="true" aria-labelledby="payment-dialog-title">
        <header>
            <div><small class="ui-text-muted">@Text["Payment_Snapshot"]</small><h4 id="payment-dialog-title">@(PaymentMethod.Type == PaymentInformationType.PayPal ? "PayPal" : Text["Payment_BankAccount"])</h4></div>
            <button type="button" title="Close payment details" @onclick="OnClose"><span class="bi bi-x-lg"></span></button>
        </header>
        <p class="snapshot-note"><span class="bi bi-lock"></span> @Text["Payment_SnapshotHelp"]</p>
        <dl>
            @if (PaymentMethod.Type == PaymentInformationType.PayPal)
            {
                <div><dt>PayPal email</dt><dd>@(PaymentMethod.PayPalEmail ?? "—")</dd></div>
            }
            else
            {
                <div><dt>@Text["Payment_AccountHolder"]</dt><dd>@(PaymentMethod.AccountHolder ?? "—")</dd></div>
                <div><dt>IBAN</dt><dd class="account-number">@(PaymentMethod.Iban ?? "—")</dd></div>
                <div><dt>BIC</dt><dd class="account-number">@(PaymentMethod.Bic ?? "—")</dd></div>
            }
        </dl>
        <footer><button type="button" class="close-button" @onclick="OnClose">@SharedText["Action_Close"]</button></footer>
    </section>
</div>
