@page "/disbursements/claim/{Token:guid}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>@PageText["Page_AllocationClaim_Title"]</PageTitle>
<div class="claim-page ui-stack-md">
    @if (!string.IsNullOrWhiteSpace(_error)) { <p class="message error">@_error</p> }
    @if (!string.IsNullOrWhiteSpace(_message)) { <p class="message success">@_message</p> }
    @if (_allocation is null) { <p>@Text["Allocation_Loading"]</p> }
    else
    {
        <section class="panel claim-heading">
            <span class="trophy bi bi-trophy-fill"></span>
            <div><small>@_allocation.EventName</small><h3>@_allocation.Name</h3><p>@_allocation.Description</p></div>
            <div class="amount"><strong>@_allocation.Amount.ToString("N2") EUR</strong><small>@Remaining.ToString("N2") EUR available</small></div>
        </section>

        @if (!HasOwnApplication && Remaining > 0)
        {
            <section class="panel application-form ui-stack-md">
                <h4>@Text["Allocation_ApplyTitle"]</h4>
                <label>@SharedText["Field_Amount"] (EUR) <InputNumber @bind-Value="_application.Amount" min="0.01" max="@Remaining" step="0.01" disabled="@_busy" /></label>
                <label>@SharedText["Field_Note"]<InputTextArea @bind-Value="_application.Note" disabled="@_busy" placeholder="Explain your share, team split, or other context." /></label>
                <div><strong>@Text["Payment_Method"]</strong><PaymentMethodSelector Methods="_paymentMethods" @bind-Value="_application.PaymentInformationId" OnRefresh="LoadPaymentMethodsAsync" Disabled="@_busy" /></div>
                <button type="button" class="primary-action" @onclick="ApplyAsync" disabled="@(_busy || _paymentMethods.Count == 0)"><span class="bi bi-send"></span> @Text["Allocation_Submit"]</button>
            </section>
        }

        <section class="applications ui-stack-md">
            <h4>@Text["Allocation_Applications"]</h4>
            @if (_allocation.Applications.Count == 0) { <div class="panel empty">@Text["Allocation_None"]</div> }
            @foreach (var application in _allocation.Applications)
            {
                <article class="panel application-card">
                    <header>
                        <div><h4>@application.ApplicantName</h4><small>@application.CreatedAt.LocalDateTime.ToString("g") · @application.Status.ToLocalizedString(SharedText)</small></div>
                        <div class="claim-card-actions">
                            <strong>@application.Amount.ToString("N2") EUR</strong>
                            @if (application.ApplicantUserId == _userId && CanModify(application))
                            {
                                <ContextMenu AriaLabel="@Text["Allocation_ClaimActions"]">
                                    <ContextMenuItem IconClass="bi-pencil" Text="@SharedText["Action_Edit"]" OnClick="() => OpenEditDialog(application)" />
                                    <ContextMenuItem IconClass="bi-x-circle" Text="@Text["Allocation_CancelClaim"]" IsDestructive="true" OnClick="() => OpenCancelDialog(application)" />
                                </ContextMenu>
                            }
                        </div>
                    </header>
                    @if (!string.IsNullOrWhiteSpace(application.Note)) { <p>@application.Note</p> }
                    <div class="approval-summary"><span class="approved"><span class="bi bi-check-circle"></span> @application.Approvals.Count(item => item.IsApproved) approvals</span><span class="objected"><span class="bi bi-x-circle"></span> @application.Approvals.Count(item => !item.IsApproved) objections</span></div>
                    <AllocationApprovalList Approvals="application.Approvals" />
                    @if (application.ApplicantUserId != _userId && CanReview(application))
                    {
                        <div class="decision-actions"><span>@Text["Allocation_ApproveQuestion"]</span><button type="button" class="approve" @onclick="() => DecideAsync(application.Id, true)" disabled="@_busy"><span class="bi bi-check-lg"></span> @Text["Allocation_Approve"]</button><button type="button" class="object" @onclick="() => DecideAsync(application.Id, false)" disabled="@_busy"><span class="bi bi-x-lg"></span> @Text["Allocation_Object"]</button></div>
                    }
                </article>
            }
        </section>
    }
</div>

@if (_editingApplication is not null)
{
    <AllocationApplicationEditDialog @key="_editingApplication.Id"
                                     Application="_editingApplication"
                                     MaximumAmount="@MaximumEditableAmount(_editingApplication)"
                                     AllowPaymentMethodSelection="true"
                                     PaymentMethods="_paymentMethods"
                                     Busy="_busy"
                                     Error="_dialogError"
                                     OnRefreshPaymentMethods="LoadPaymentMethodsAsync"
                                     OnSubmit="UpdateApplicationAsync"
                                     OnClose="CloseDialogs" />
}

@if (_cancellingApplication is not null)
{
    <AllocationApplicationCancelDialog Application="_cancellingApplication"
                                       Busy="_busy"
                                       Error="_dialogError"
                                       OnConfirm="CancelApplicationAsync"
                                       OnClose="CloseDialogs" />
}
