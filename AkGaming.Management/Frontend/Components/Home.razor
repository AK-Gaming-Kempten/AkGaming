@page "/"
@using AkGaming.Core.Constants

<PageTitle>@PageText["Page_Home_Title"]</PageTitle>

<section class="home-hero">
    <div class="home-hero-icon" aria-hidden="true">
        <img src="images/icons/AKG_Logos/default.png" alt="@($"{ClubConstants.Organization.ShortName} logo")" class="home-hero-logo" />
    </div>

    <h1>@PageText["Page_Home_Title"]</h1>
    <p class="home-hero-subtitle">@PageText["Page_Home_Description"]</p>

    <p class="home-hero-teaser">@PageText["Page_Home_Teaser"]</p>
</section>
