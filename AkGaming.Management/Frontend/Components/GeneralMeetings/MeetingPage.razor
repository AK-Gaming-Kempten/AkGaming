@page "/general-meetings/{MeetingId:guid}"
@using Microsoft.AspNetCore.Authorization
@using AkGaming.Management.Modules.GeneralMeetings.Contracts
@attribute [Authorize]

<PageTitle>@(_meeting?.Title ?? PageText["Page_GeneralMeeting_Title"])</PageTitle>
@if (_canAccess is null) { <p>@Text["Access_Checking"]</p> }
else if (!_canAccess.Value)
{
<UnauthorizedPanel ImageUrl="images/icons/AKG_Logos/Red.png">
    <p>@Text["Access_Denied"]</p>
</UnauthorizedPanel>
}
else if (_meeting is null) { <p>@(_error ?? "Loading...")</p> }
else
{
<div class="meeting-page ui-stack-md">
    <section class="panel meeting-header"><div><a href="general-meetings">← @Text["General_Back"]</a><h2>@_meeting.Title</h2><p>@_meeting.ScheduledAt.ToLocalTime().ToString("g") · @(_meeting.Location ?? Text["General_LocationPending"])</p></div><span class="status">@_meeting.Status.ToLocalizedString(SharedText)</span></section>
    @if (!string.IsNullOrWhiteSpace(_error)) { <p class="error">@_error</p> }
    @if (!string.IsNullOrWhiteSpace(_success)) { <p class="success">@_success</p> }

    <section class="panel actions">
        <button type="button" @onclick="CheckInAsync">@Text["General_CheckIn"]</button>
        <AuthorizeView Policy="management.general-meetings.manage">
            <button type="button" @onclick="SendInvitationAsync">@Text["General_SendInvitations"]</button>
            <button type="button" @onclick="SendReminderAsync">@Text["General_SendReminder"]</button>
            @foreach (var status in _nextStatuses) { <button type="button" @onclick="() => ChangeStatusAsync(status)">Set @status</button> }
            @if (_meeting.Status == MeetingStatusDto.Closed) { <button class="danger-action" type="button" @onclick="FinalizeAsync">@Text["General_Finalize"]</button> }
        </AuthorizeView>
    </section>

    <div class="meeting-columns">
        <section class="panel ui-stack-sm"><h3>@Text["Board_Agenda"]</h3>
            <AuthorizeView Policy="management.general-meetings.manage"><button type="button" @onclick="StartAgendaDraft">@SharedText["Action_AddAgendaItem"]</button></AuthorizeView>
            @foreach (var item in OrderedAgenda)
            {
                <article class="agenda-item @(item.Id == _meeting.CurrentAgendaItemId ? "current" : null)" style="margin-left:@(Depth(item) * 1.25)rem">
                    <div class="agenda-heading"><div><strong>@item.Heading</strong><small>@item.Status.ToLocalizedString(SharedText)</small></div><AuthorizeView Policy="management.general-meetings.manage"><span><button type="button" @onclick="() => EditAgenda(item)">@SharedText["Action_Edit"]</button> <button type="button" @onclick="() => MakeCurrentAsync(item.Id)">@SharedText["Action_MakeCurrent"]</button></span></AuthorizeView></div>
                    @if (!string.IsNullOrWhiteSpace(item.Description)) { <p class="preserve">@item.Description</p> }
                    <AuthorizeView Policy="management.general-meetings.minutes.write"><LiveMinutesEditor Value="@item.Minutes" OnSave="minutes => SaveMinutesAsync(item.Id, minutes)" /></AuthorizeView>
                    <AuthorizeView Policy="management.general-meetings.manage"><button type="button" @onclick="() => StartBallotDraft(item.Id)">Add ballot</button></AuthorizeView>
                    @foreach (var ballot in item.Ballots) { <BallotPanel Ballot="ballot" MeetingId="MeetingId" CanManage="_canManage" Attendees="_meeting.Attendees" OnEdit="StartBallotEdit" OnChanged="ReloadAsync" /> }
                </article>
            }
        </section>

        <section class="panel ui-stack-sm"><h3>Attendees <small>(@_meeting.Attendees.Count(x => x.CheckedInAt.HasValue && !x.CheckedOutAt.HasValue) present)</small></h3>
            <AuthorizeView Policy="management.general-meetings.manage">
                <div class="attendee-add"><select @bind="_selectedMemberId"><option value="">Select member</option>@foreach (var member in _members.Where(m => _meeting.Attendees.All(a => a.MemberId != m.Id))) { <option value="@member.Id">@MemberName(member)</option> }</select><button type="button" @onclick="AddAttendeeAsync">@SharedText["Action_AddWithoutCheckIn"]</button></div>
            </AuthorizeView>
            <ul class="attendee-list">@foreach (var attendee in _meeting.Attendees) { <li><span class="presence @(attendee.IsOnline ? "online" : null)"></span><span><strong>@attendee.DisplayName</strong><small>@attendee.MembershipStatus · @(attendee.CheckedInAt.HasValue && !attendee.CheckedOutAt.HasValue ? "checked in" : "not present")</small></span><AuthorizeView Policy="management.general-meetings.manage"><button type="button" @onclick="() => ToggleAttendanceAsync(attendee)">@(attendee.CheckedInAt.HasValue && !attendee.CheckedOutAt.HasValue ? "Check out" : "Check in")</button></AuthorizeView></li> }</ul>
        </section>
    </div>
    @if (_meeting.Protocol is not null) { <section class="panel"><h3>@SharedText["Heading_FinalProtocol"]</h3><p><small>Revision @_meeting.Protocol.Revision · SHA-256 @_meeting.Protocol.Sha256</small></p><pre class="protocol">@_meeting.Protocol.Markdown</pre></section> }
</div>

@if (_showAgendaForm)
{
    <GeneralMeetingFormDialog Title="@(_editingAgendaItemId.HasValue ? "Edit agenda item" : "Add agenda item")"
                              Description="Agenda items may be nested and reordered later. Descriptions support Markdown."
                              OnClose="CloseAgendaDialog">
        <ChildContent>
            <div class="meeting-dialog-form">
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <p class="error">@_error</p>
                }
                <label>Heading <InputText autofocus placeholder="Agenda item heading" @bind-Value="_agendaHeading" /></label>
                <label>@SharedText["Field_Description"]<InputTextArea placeholder="Description (Markdown)" @bind-Value="_agendaDescription" /></label>
                <label>Parent <select @bind="_agendaParent"><option value="">None</option>@foreach (var item in _meeting.AgendaItems.Where(x => x.Id != _editingAgendaItemId)) { <option value="@item.Id">@item.Heading</option> }</select></label>
                <label>Order <InputNumber @bind-Value="_agendaOrder" /></label>
            </div>
        </ChildContent>
        <Footer>
            <button type="button" class="dialog-cancel" @onclick="CloseAgendaDialog">@SharedText["Action_Cancel"]</button>
            <button type="button" class="dialog-primary" @onclick="CreateAgendaAsync">@(_editingAgendaItemId.HasValue ? "Save changes" : "Add agenda item")</button>
        </Footer>
    </GeneralMeetingFormDialog>
}

@if (_ballotAgendaItemId.HasValue)
{
    <GeneralMeetingFormDialog Eyebrow="Secret ballot"
                              Title="@(_editingBallotId.HasValue ? "Edit ballot" : "Add ballot")"
                              Description="Ballots are secret and single-use. The ballot remains editable until it is opened."
                              OnClose="CloseBallotDialog">
        <ChildContent>
            <div class="meeting-dialog-form">
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <p class="error">@_error</p>
                }
                <label>Question <InputText autofocus placeholder="What should attendees vote on?" @bind-Value="_ballotQuestion" /></label>
                <label>Type <InputSelect @bind-Value="_ballotType"><option value="YesNoAbstain">@SharedText["Option_YesNoAbstain"]</option><option value="Nomination">@SharedText["Heading_Nominations"]</option></InputSelect></label>
                @if (_ballotType == BallotTypeDto.Nomination)
                {
                    <label>Nominations <InputTextArea placeholder="Enter nominations separated by semicolons" @bind-Value="_ballotOptions" /></label>
                    <label>Maximum selections <InputNumber @bind-Value="_maximumSelections" /></label>
                }
                <label class="meeting-dialog-checkbox"><InputCheckbox @bind-Value="_showLiveResults" /> Show results while the ballot is open</label>
            </div>
        </ChildContent>
        <Footer>
            <button type="button" class="dialog-cancel" @onclick="CloseBallotDialog">@SharedText["Action_Cancel"]</button>
            <button type="button" class="dialog-primary" @onclick="CreateBallotAsync">@(_editingBallotId.HasValue ? "Save changes" : "Add ballot")</button>
        </Footer>
    </GeneralMeetingFormDialog>
}
}
