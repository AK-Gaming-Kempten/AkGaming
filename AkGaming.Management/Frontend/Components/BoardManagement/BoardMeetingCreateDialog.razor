@using AkGaming.Management.Frontend.Components.GeneralMeetings

<GeneralMeetingFormDialog Eyebrow="@Text["Board_Management"]"
                          Title="@Text["Board_CreateTitle"]"
                          Description="@Text["Board_CreateDescription"]"
                          OnClose="OnClose">
    <ChildContent>
        <div class="board-meeting-form">
            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <p class="create-meeting-error" role="alert">@Error</p>
            }
            <label>@SharedText["Field_Title"]<InputText @bind-Value="_title" /></label>
            <div class="board-meeting-form-row">
                <label>@SharedText["Field_DateTime"] <input type="datetime-local" @bind="_scheduledLocal" /></label>
                <label>@SharedText["Field_DurationMinutes"] <InputNumber @bind-Value="_durationMinutes" /></label>
            </div>
            <label>@SharedText["Field_Location"]<InputText @bind-Value="_location" /></label>

            <section class="draft-agenda">
                <div class="draft-agenda-heading">
                    <div>
                        <h4>@Text["Board_InitialAgenda"]</h4>
                        <p class="ui-text-muted">@Text["Board_InitialAgendaHelp"]</p>
                    </div>
                    <div class="draft-agenda-actions">
                        <button type="button" disabled="@IsBusy" @onclick="AddAgendaItem">
                            <span class="bi bi-plus-lg"></span> @Text["Board_AddItem"]
                        </button>
                        <button type="button" disabled="@IsBusy" @onclick="OpenBacklogSelection">
                            <span class="bi bi-archive"></span> @Text["Board_AddBacklog"]
                            <span class="backlog-count" aria-label="@Text["Board_BacklogAvailable", AvailableBacklogItems.Count]">@AvailableBacklogItems.Count</span>
                        </button>
                    </div>
                </div>

                @if (_agendaItems.Count == 0)
                {
                    <p class="draft-agenda-empty">@SharedText["State_NoAgenda"]</p>
                }
                else
                {
                    @for (var index = 0; index < _agendaItems.Count; index++)
                    {
                        var item = _agendaItems[index];
                        var itemNumber = index + 1;
                        <BoardAgendaDropZone Position="index"
                                             IsEnabled="@_draggedAgendaItemId.HasValue"
                                             OnDropped="DropAtPosition" />
                        <article class="draft-agenda-item @(_draggedAgendaItemId == item.Id ? "dragging" : string.Empty)"
                                 draggable="true"
                                 data-ak-draggable="true"
                                 data-ak-drag-id="@item.Id"
                                 @key="item.Id"
                                 @ondragstart="() => StartDragging(item.Id)"
                                 @ondragend="StopDragging">
                            <div class="draft-agenda-item-heading">
                                <strong><span class="bi bi-grip-vertical draft-drag-handle"></span> @Text["Board_Item"] @itemNumber</strong>
                                <button type="button" class="remove-agenda-item" disabled="@IsBusy" title="Remove agenda item" aria-label="Remove agenda item" @onclick="() => RemoveAgendaItem(item)">
                                    <span class="bi bi-trash"></span>
                                </button>
                            </div>
                            <label>@SharedText["Field_Title"]<InputText @bind-Value="item.Title" /></label>
                            <label>@SharedText["Field_Description"]<InputTextArea @bind-Value="item.Description" /></label>
                        </article>
                    }
                    <BoardAgendaDropZone Position="_agendaItems.Count"
                                         IsEnabled="@_draggedAgendaItemId.HasValue"
                                         OnDropped="DropAtPosition" />
                }
            </section>
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="dialog-cancel" disabled="@IsBusy" @onclick="OnClose">@SharedText["Action_Cancel"]</button>
        <button type="button" class="dialog-primary" disabled="@IsBusy" @onclick="SubmitAsync">@(IsBusy ? Text["Board_Creating"] : Text["Board_Create"])</button>
    </Footer>
</GeneralMeetingFormDialog>

@if (_showBacklogSelection)
{
    <BoardBacklogSelectionDialog Items="AvailableBacklogItems"
                                 IsBusy="IsBusy"
                                 OnSubmit="AddBacklogItems"
                                 OnClose="CloseBacklogSelection" />
}
