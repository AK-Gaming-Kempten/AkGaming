@page "/board/meetings/{MeetingId:guid}"
@using Microsoft.AspNetCore.Authorization
@using AkGaming.Management.Modules.BoardManagement.Contracts
@using AkGaming.Management.Frontend.Components.GeneralMeetings
@attribute [Authorize(Policy = "management.board-meetings.read")]

<PageTitle>Board Meeting</PageTitle>
@if (_meeting is null) { <p>@(_error ?? "Loading...")</p> }
else
{
<div class="ui-stack-md">
    <section class="panel meetings-heading"><div><a href="board/meetings">← Board meetings</a><h2>@_meeting.Title</h2><p>@_meeting.ScheduledAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @_meeting.DurationMinutes min · @(_meeting.Location ?? "Location pending")</p></div><span class="meeting-status">@_meeting.Status</span></section>
    @if (!string.IsNullOrWhiteSpace(_error)) { <p class="error">@_error</p> }
    @if (_meeting.Status == BoardMeetingStatusDto.Scheduled)
    {
        <section class="panel ui-stack-sm">
            <h3>Can you attend?</h3>
            <div class="ui-actions"><button type="button" disabled="@_busy" @onclick="() => SetAvailabilityAsync(BoardAvailabilityStatusDto.Available)">I have time</button><button type="button" disabled="@_busy" @onclick="() => SetAvailabilityAsync(BoardAvailabilityStatusDto.Unavailable)">I cannot attend</button></div>
            <p>@_meeting.Availabilities.Count(x => x.Status == BoardAvailabilityStatusDto.Available) available · @_meeting.Availabilities.Count(x => x.Status == BoardAvailabilityStatusDto.Unavailable) unavailable</p>
            <ul>@foreach (var response in _meeting.Availabilities) { <li><strong>@response.DisplayName</strong>: @response.Status</li> }</ul>
        </section>
    }
    <section class="panel ui-stack-sm">
        <div class="meetings-heading"><h3>Rescheduling</h3><button type="button" @onclick="ToggleProposal">@(_showProposal ? "Cancel" : "Propose another date")</button></div>
        @if (_showProposal)
        {
            <label>Proposed date <input type="datetime-local" @bind="_newDateLocal" /></label><label>Duration <InputNumber @bind-Value="_newDuration" /></label><label>Reason <InputTextArea @bind-Value="_reason" /></label>
            <div class="ui-actions"><button type="button" disabled="@_busy" @onclick="ProposeAsync">Submit proposal</button><AuthorizeView Policy="management.board-meetings.manage"><button type="button" disabled="@_busy" @onclick="RescheduleImmediatelyAsync">Reschedule immediately</button></AuthorizeView></div>
        }
        @foreach (var proposal in _meeting.RescheduleProposals)
        {
            <div class="ui-divider-top-dashed"><strong>@proposal.ProposedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong> · @proposal.DurationMinutes min · proposed by @proposal.ProposedByDisplayName · @proposal.Status @if (!string.IsNullOrWhiteSpace(proposal.Reason)) { <p>@proposal.Reason</p> } @if (proposal.Status == RescheduleProposalStatusDto.Pending) { <AuthorizeView Policy="management.board-meetings.manage"><div class="ui-actions"><button type="button" @onclick="() => DecideAsync(proposal.Id, true)">Accept</button><button type="button" @onclick="() => DecideAsync(proposal.Id, false)">Reject</button></div></AuthorizeView> }</div>
        }
        <AuthorizeView Policy="management.board-meetings.manage"><button type="button" disabled="@_busy" @onclick="CancelMeetingAsync">Cancel meeting</button></AuthorizeView>
    </section>
    <section class="panel ui-stack-sm">
        <div class="meetings-heading agenda-heading">
            <div><h3>Agenda</h3><p class="ui-text-muted">Drag items to reorder them. Further actions are available from each item's context menu.</p></div>
            @if (_canManage)
            {
                <div class="ui-actions">
                    <button type="button" @onclick="OpenAgendaCreateDialog"><span class="bi bi-plus-lg"></span> Add item</button>
                    <button type="button" @onclick="OpenBacklogDialogAsync"><span class="bi bi-archive"></span> Add from backlog</button>
                </div>
            }
        </div>
        @if (_meeting.AgendaItems.Count == 0) { <p>No agenda items.</p> }
        else
        {
            <div class="board-agenda-list">
                @{ var orderedAgendaItems = _meeting.AgendaItems.OrderBy(x => x.Order).ToList(); }
                @for (var position = 0; position <= orderedAgendaItems.Count; position++)
                {
                    <BoardAgendaDropZone Position="position"
                                         IsEnabled="@(_canManage && _draggedAgendaItemId.HasValue)"
                                         OnDropped="DropAgendaItemAtPositionAsync" />
                    @if (position < orderedAgendaItems.Count)
                    {
                        var item = orderedAgendaItems[position];
                        <BoardAgendaItemCard @key="item.Id"
                                             Item="item"
                                             CanManage="_canManage"
                                             IsDragging="@(_draggedAgendaItemId == item.Id)"
                                             OnEdit="StartAgendaEdit"
                                             OnComplete="CompleteAgendaAsync"
                                             OnMoveToBacklog="PostponeAgendaAsync"
                                             OnDelete="OpenDeleteAgendaDialog"
                                             OnDragStarted="StartAgendaDrag"
                                             OnDragEnded="EndAgendaDrag" />
                    }
                }
            </div>
        }
    </section>
</div>

@if (_showAgendaDialog)
{
    <GeneralMeetingFormDialog Eyebrow="Board agenda"
                              Title="@(_editingAgendaItemId.HasValue ? "Edit agenda item" : "Add agenda item")"
                              Description="Agenda items can be reordered by dragging them after they are saved."
                              OnClose="CloseAgendaDialog">
        <ChildContent>
            <div class="agenda-dialog-form">
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <p class="error">@_error</p>
                }
                <label>Title <InputText autofocus @bind-Value="_agendaTitle" /></label>
                <label>Description <InputTextArea @bind-Value="_agendaDescription" /></label>
            </div>
        </ChildContent>
        <Footer>
            <button type="button" class="dialog-cancel" disabled="@_busy" @onclick="CloseAgendaDialog">Cancel</button>
            <button type="button" class="dialog-primary" disabled="@_busy" @onclick="SaveAgendaAsync">@(_editingAgendaItemId.HasValue ? "Save changes" : "Add item")</button>
        </Footer>
    </GeneralMeetingFormDialog>
}

@if (_showBacklogDialog)
{
    <BoardBacklogSelectionDialog Items="_backlogItems"
                                 IsBusy="_busy"
                                 Error="@_error"
                                 OnSubmit="AssignBacklogItemsAsync"
                                 OnClose="CloseBacklogDialog" />
}

@if (_deletingAgendaItem is not null)
{
    <BoardAgendaDeleteDialog Item="_deletingAgendaItem"
                             IsBusy="_busy"
                             Error="@_error"
                             OnConfirm="DeleteAgendaAsync"
                             OnClose="CloseDeleteAgendaDialog" />
}
}
