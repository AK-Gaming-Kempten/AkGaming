@page "/board/meetings/{MeetingId:guid}"
@using Microsoft.AspNetCore.Authorization
@using AkGaming.Management.Modules.BoardManagement.Contracts
@using AkGaming.Management.Frontend.Components.GeneralMeetings
@attribute [Authorize(Policy = "management.board-meetings.read")]

<PageTitle>@PageText["Page_BoardMeeting_Title"]</PageTitle>
@if (_meeting is null) { <p>@(_error ?? "Loading...")</p> }
else
{
<div class="ui-stack-md">
    <section class="panel meetings-heading"><div><a href="board/meetings">← @Text["Board_Back"]</a><h2>@_meeting.Title</h2><p>@_meeting.ScheduledAtUtc.ToLocalTime().ToString("g") · @_meeting.DurationMinutes @SharedText["Unit_Minutes"] · @(_meeting.Location ?? Text["General_LocationPending"])</p></div><span class="meeting-status">@_meeting.Status.ToLocalizedString(SharedText)</span></section>
    @if (!string.IsNullOrWhiteSpace(_error)) { <p class="error">@_error</p> }
    @if (_meeting.Status == BoardMeetingStatusDto.Scheduled)
    {
        <section class="panel ui-stack-sm">
            <h3>@Text["Board_AttendQuestion"]</h3>
            <div class="ui-actions"><button type="button" disabled="@_busy" @onclick="() => SetAvailabilityAsync(BoardAvailabilityStatusDto.Available)">@Text["Board_Available"]</button><button type="button" disabled="@_busy" @onclick="() => SetAvailabilityAsync(BoardAvailabilityStatusDto.Unavailable)">@Text["Board_Unavailable"]</button></div>
            <p>@_meeting.Availabilities.Count(x => x.Status == BoardAvailabilityStatusDto.Available) @Text["Board_AvailableCount"] · @_meeting.Availabilities.Count(x => x.Status == BoardAvailabilityStatusDto.Unavailable) @Text["Board_UnavailableCount"]</p>
            <ul>@foreach (var response in _meeting.Availabilities) { <li><strong>@response.DisplayName</strong>: @response.Status.ToLocalizedString(SharedText)</li> }</ul>
        </section>
    }
    <section class="panel ui-stack-sm">
        <div class="meetings-heading"><h3>@Text["Board_Rescheduling"]</h3><button type="button" @onclick="ToggleProposal">@(_showProposal ? SharedText["Action_Cancel"] : Text["Board_ProposeDate"])</button></div>
        @if (_showProposal)
        {
            <label>@Text["Board_ProposedDate"] <input type="datetime-local" @bind="_newDateLocal" /></label><label>@SharedText["Field_Duration"]<InputNumber @bind-Value="_newDuration" /></label><label>@SharedText["Field_Reason"]<InputTextArea @bind-Value="_reason" /></label>
            <div class="ui-actions"><button type="button" disabled="@_busy" @onclick="ProposeAsync">@Text["Board_SubmitProposal"]</button><AuthorizeView Policy="management.board-meetings.manage"><button type="button" disabled="@_busy" @onclick="RescheduleImmediatelyAsync">@Text["Board_RescheduleNow"]</button></AuthorizeView></div>
        }
        @foreach (var proposal in _meeting.RescheduleProposals)
        {
            <div class="ui-divider-top-dashed"><strong>@proposal.ProposedAtUtc.ToLocalTime().ToString("g")</strong> · @proposal.DurationMinutes @SharedText["Unit_Minutes"] · @Text["Board_ProposedBy"] @proposal.ProposedByDisplayName · @proposal.Status.ToLocalizedString(SharedText) @if (!string.IsNullOrWhiteSpace(proposal.Reason)) { <p>@proposal.Reason</p> } @if (proposal.Status == RescheduleProposalStatusDto.Pending) { <AuthorizeView Policy="management.board-meetings.manage"><div class="ui-actions"><button type="button" @onclick="() => DecideAsync(proposal.Id, true)">@Text["Board_Accept"]</button><button type="button" @onclick="() => DecideAsync(proposal.Id, false)">@Text["Board_Reject"]</button></div></AuthorizeView> }</div>
        }
        <AuthorizeView Policy="management.board-meetings.manage"><button type="button" disabled="@_busy" @onclick="CancelMeetingAsync">@Text["Board_CancelMeeting"]</button></AuthorizeView>
    </section>
    <section class="panel ui-stack-sm">
        <div class="meetings-heading agenda-heading">
            <div><h3>@Text["Board_Agenda"]</h3><p class="ui-text-muted">@Text["Board_AgendaHelp"]</p></div>
            @if (_canManage)
            {
                <div class="ui-actions">
                    <button type="button" @onclick="OpenAgendaCreateDialog"><span class="bi bi-plus-lg"></span> @Text["Board_AddItem"]</button>
                    <button type="button" @onclick="OpenBacklogDialogAsync"><span class="bi bi-archive"></span> @Text["Board_AddBacklog"]</button>
                </div>
            }
        </div>
        @if (_meeting.AgendaItems.Count == 0) { <p>@Text["Board_NoAgenda"]</p> }
        else
        {
            <div class="board-agenda-list">
                @{ var orderedAgendaItems = _meeting.AgendaItems.OrderBy(x => x.Order).ToList(); }
                @for (var position = 0; position <= orderedAgendaItems.Count; position++)
                {
                    <BoardAgendaDropZone Position="position"
                                         IsEnabled="@(_canManage && _draggedAgendaItemId.HasValue)"
                                         OnDropped="DropAgendaItemAtPositionAsync" />
                    @if (position < orderedAgendaItems.Count)
                    {
                        var item = orderedAgendaItems[position];
                        <BoardAgendaItemCard @key="item.Id"
                                             Item="item"
                                             CanManage="_canManage"
                                             IsDragging="@(_draggedAgendaItemId == item.Id)"
                                             OnEdit="StartAgendaEdit"
                                             OnComplete="CompleteAgendaAsync"
                                             OnMoveToBacklog="PostponeAgendaAsync"
                                             OnDelete="OpenDeleteAgendaDialog"
                                             OnDragStarted="StartAgendaDrag"
                                             OnDragEnded="EndAgendaDrag" />
                    }
                }
            </div>
        }
    </section>
</div>

@if (_showAgendaDialog)
{
    <GeneralMeetingFormDialog Eyebrow="@Text["Board_Agenda"]"
                              Title="@(_editingAgendaItemId.HasValue ? Text["Board_EditAgendaItem"] : Text["Board_AddAgendaItem"])"
                              Description="@Text["Board_AgendaDialogDescription"]"
                              OnClose="CloseAgendaDialog">
        <ChildContent>
            <div class="agenda-dialog-form">
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <p class="error">@_error</p>
                }
                <label>@SharedText["Field_Title"]<InputText autofocus @bind-Value="_agendaTitle" /></label>
                <label>@SharedText["Field_Description"]<InputTextArea @bind-Value="_agendaDescription" /></label>
            </div>
        </ChildContent>
        <Footer>
            <button type="button" class="dialog-cancel" disabled="@_busy" @onclick="CloseAgendaDialog">@SharedText["Action_Cancel"]</button>
            <button type="button" class="dialog-primary" disabled="@_busy" @onclick="SaveAgendaAsync">@(_editingAgendaItemId.HasValue ? SharedText["Action_Save"] : Text["Board_AddItem"])</button>
        </Footer>
    </GeneralMeetingFormDialog>
}

@if (_showBacklogDialog)
{
    <BoardBacklogSelectionDialog Items="_backlogItems"
                                 IsBusy="_busy"
                                 Error="@_error"
                                 OnSubmit="AssignBacklogItemsAsync"
                                 OnClose="CloseBacklogDialog" />
}

@if (_deletingAgendaItem is not null)
{
    <BoardAgendaDeleteDialog Item="_deletingAgendaItem"
                             IsBusy="_busy"
                             Error="@_error"
                             OnConfirm="DeleteAgendaAsync"
                             OnClose="CloseDeleteAgendaDialog" />
}
}
