@using AkGaming.Core.Constants

<section class="ui-stack-md membership-requests">
    @if (ShowStatuses) {
        <article class="panel ui-stack-md">
            <h3>Membership Requests</h3>
            @if (ApplicationRequests.Count == 0 && LinkingRequests.Count == 0) {
                <p class="ui-text-muted">No membership applications or linking requests have been sent.</p>
            }
            else {
                <div class="request-status-list">
                    @foreach (var request in ApplicationRequests) {
                        <div class="request-status-entry">
                            <div><strong>Membership application</strong><span class="ui-text-muted">@RequestDetails(request)</span></div>
                            <span class="request-status @(request.IsResolved ? "resolved" : "pending")">@(request.IsResolved ? "Resolved" : "Pending")</span>
                        </div>
                    }
                    @foreach (var request in LinkingRequests) {
                        <div class="request-status-entry">
                            <div><strong>Membership linking request</strong><span class="ui-text-muted">@request.Reason</span></div>
                            <span class="request-status @(request.IsResolved ? "resolved" : "pending")">@(request.IsResolved ? "Resolved" : "Pending")</span>
                        </div>
                    }
                </div>
            }
        </article>
    }

    @if (CanCreateRequests && !HasPendingRequest) {
        <article class="panel ui-stack-md">
            <div>
                <h3>Membership Actions</h3>
                <p class="ui-text-muted">Apply for membership or link your account to an existing club member record.</p>
            </div>
            <div class="ui-actions">
                <ActionButton Kind="ActionButtonKind.Create" Variant="ActionButtonVariant.Primary" OnClick="ShowApply" Label="Apply for membership" />
                <ActionButton Kind="ActionButtonKind.Link" OnClick="ShowRequestLink" Label="Request member linking" />
            </div>
        </article>
    }

    @if (_formMode != FormMode.None) {
        <div class="membership-request-dialog-backdrop" @onclick="CloseDialog"></div>
        <div class="membership-request-dialog-shell" role="dialog" aria-modal="true" aria-labelledby="membership-request-dialog-title">
            <section class="panel membership-request-dialog">
                <header class="membership-request-dialog-header">
                    <h3 id="membership-request-dialog-title">@DialogTitle</h3>
                    <ActionButton Kind="ActionButtonKind.Close" Variant="ActionButtonVariant.Outline" Size="ActionButtonSize.Small" OnClick="CloseDialog" Label="Close dialog" />
                </header>
                <div class="membership-request-dialog-content">
                    @if (_formMode == FormMode.RequestLink) {
                        <RequestMemberLinkingPanel UserGuid="@UserId" Member="@Member" OnSubmitted="HandleSubmittedAsync" />
                    }
                    else if (_formMode == FormMode.Apply) {
                        <ApplyForMembershipPanel UserGuid="@UserId" Member="@Member" OnSubmitted="HandleSubmittedAsync" />
                    }
                </div>
            </section>
        </div>
    }
</section>
