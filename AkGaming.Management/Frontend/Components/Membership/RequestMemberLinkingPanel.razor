@using AkGaming.Management.Modules.MemberManagement.Contracts.Enums
@using AkGaming.Core.Constants
<div class="member-form">
    <EditForm Model="@_profile" OnValidSubmit="@RequestMemberLinkingAsync">
        <DataAnnotationsValidator />
        <h3> Request member linking </h3>
        <hr class="spacer" />
        <div class="form-grid">
            <div class="form-col">
                <label>First Name</label>
                <InputText @bind-Value="_profile.FirstName" required />
            </div>

            <div class="form-col">
                <label>Last Name</label>
                <InputText @bind-Value="_profile.LastName" required />
            </div>

            <div class="form-col">
                <label>Email</label>
                <InputText @bind-Value="_profile.Email" required />
            </div>

            <div class="form-col">
                <label>Discord Username</label>
                <InputText @bind-Value="_profile.DiscordUserName" required />
            </div>
            <div class="form-col">
                <label>Phone</label>
                <InputText @bind-Value="_profile.Phone" />
            </div>
            <div class="form-col">
                <label>Birth Date</label>
                <InputDate @bind-Value="_profile.BirthDate" />
            </div>

            <div class="form-col">
                <label>Reason</label>
                <InputSelect @bind-Value="_request.Reason" required >
                    @foreach (var s in Enum.GetValues<MemberLinkingRequestReason>()) {
                        <option value="@s">@s</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => _request.Reason)" />
            </div>
        </div>
        <h5>Address</h5>
        <div class="form-grid">
            <div class="form-col"><label>Street / House Number</label><InputText @bind-Value="_profile.Address.Street" /></div>
            <div class="form-col"><label>Zip Code</label><InputText @bind-Value="_profile.Address.ZipCode" /></div>
            <div class="form-col"><label>City</label><InputText @bind-Value="_profile.Address.City" /></div>
            <div class="form-col"><label>Country</label><InputText @bind-Value="_profile.Address.Country" /></div>
        </div>
        <div class="form-grid">
            <div class="form-col">
                <div class="form-checkbox-with-text">
                    <InputCheckbox @bind-Value="_request.PrivacyPolicyAccepted"/>
                    <label>
                        I accept the <a href="@ClubConstants.Urls.PrivacyPolicy" target="_blank" rel="noopener noreferrer">privacy policy</a>.
                    </label>
                </div>
                <ValidationMessage For="@(() => _request.PrivacyPolicyAccepted)"/>
            </div>
        </div>

        <hr class="spacer" />
        <button type="submit" class="btn btn-primary ">Apply</button>
        @if (!string.IsNullOrWhiteSpace(_requestError)) {
            <p class="text-danger">@_requestError</p>
        }
    </EditForm>
</div>
