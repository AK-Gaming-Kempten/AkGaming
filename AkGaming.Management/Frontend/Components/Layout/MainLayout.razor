@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IStringLocalizer<NavigationStrings> Text

<div class="page">
    <header class="mobile-header">
        <button type="button"
                class="mobile-menu-toggle"
                aria-label="@Text["Navigation_Toggle"]"
                aria-expanded="@_isMobileNavOpen"
                @onclick="ToggleMobileNav">
            <span class="bi bi-list"></span>
        </button>
        <div class="mobile-header-brand">
            <img src="images/icons/AKG_Logos/default.png" alt="AKGaming Logo" class="mobile-header-logo" />
            <span>@Text["App_Name"]</span>
        </div>
    </header>

    <div class="layout-shell">
        <aside class="sidebar-drawer @(_isMobileNavOpen ? "is-open" : string.Empty)">
            <NavMenu OnNavigate="CloseMobileNav" />
        </aside>

        @if (_isMobileNavOpen)
        {
            <button type="button" class="sidebar-backdrop" aria-label="@Text["Navigation_Close"]" @onclick="CloseMobileNav"></button>
        }

        <main @onclick="CloseMobileNavIfOpen">
            <article class="content @(IsHomeRoute ? "content-fullbleed" : string.Empty)">
                @if (!IsHomeRoute)
                {
                    <PageBannerHost />
                }
                @Body
            </article>
        </main>
    </div>
</div>

<ReconnectOverlay AppName="AK Gaming Management"
                  LogoUrl="images/icons/AKG_Logos/Default.png"
                  ShowMessage="Trying to restore your live session and reconnect to the management server." />
<BlazorErrorDisplay AppName="AK Gaming Management" />

@code {
    private bool _isMobileNavOpen;
    private bool IsHomeRoute => string.IsNullOrWhiteSpace(Nav.ToBaseRelativePath(Nav.Uri));

    private void ToggleMobileNav() => _isMobileNavOpen = !_isMobileNavOpen;

    private void CloseMobileNav() => _isMobileNavOpen = false;

    private void CloseMobileNavIfOpen()
    {
        if (_isMobileNavOpen)
        {
            _isMobileNavOpen = false;
        }
    }
}
