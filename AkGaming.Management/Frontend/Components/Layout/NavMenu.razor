@inject IStringLocalizer<NavigationStrings> Text

<div class="sidebar">
    <div class="sidebar-header">
        <img src="images/icons/AKG_Logos/default.png" alt="AKGaming Logo" class="sidebar-logo">
        <span class="sidebar-title">@Text["App_Name"]</span>
    </div>

    <div class="sidebar-content">
        <nav class="sidebar-nav">
            <NavLink href="" Match="NavLinkMatch.All" class="nav-item level-1" @onclick="NotifyNavigation">
                <span class="nav-icon bi-house-door-fill"></span>
                <span>@Text["Home"]</span>
            </NavLink>

            <NavLink href="membership" class="nav-item level-1" @onclick="NotifyNavigation">
                <span class="nav-icon bi-person-fill"></span>
                <span>@Text["Profile"]</span>
            </NavLink>

            @if (canAccessGeneralMeetings)
            {
                <NavLink href="general-meetings" class="nav-item level-1" @onclick="NotifyNavigation">
                    <span class="nav-icon bi-people"></span>
                    <span>@Text["GeneralMeetings"]</span>
                </NavLink>
            }

            @if (canReadBoardMeetings)
            {
                <NavLink href="board/meetings" class="nav-item level-1" @onclick="NotifyNavigation">
                    <span class="nav-icon bi-calendar2-week"></span>
                    <span>@Text["BoardMeetings"]</span>
                </NavLink>
            }

            @if (isAuthenticated)
            {
                <div class="nav-section">
                    <button type="button" class="nav-section-toggle nav-item level-1 @(isDisbursementsExpanded ? "active" : null)" @onclick="ToggleDisbursementsExpanded">
                        <span class="nav-icon bi-wallet2"></span>
                        @Text["Disbursements"]
                        <span class="nav-chevron bi @(isDisbursementsExpanded ? "bi-chevron-up" : "bi-chevron-down")"></span>
                    </button>
                    @if (isDisbursementsExpanded)
                    {
                        <NavLink href="disbursements/reimbursements/my" class="nav-item level-2" @onclick="NotifyNavigation">
                            <span class="nav-icon bi-receipt-cutoff"></span><span>@Text["MyReimbursements"]</span>
                        </NavLink>
                        <NavLink href="disbursements/allocations/my" class="nav-item level-2" @onclick="NotifyNavigation">
                            <span class="nav-icon bi-trophy"></span><span>@Text["MyAllocations"]</span>
                        </NavLink>
                        @if (canReadDisbursements)
                        {
                            <NavLink href="disbursements/admin/reimbursements" class="nav-item level-2" @onclick="NotifyNavigation">
                                <span class="nav-icon bi-clipboard-check"></span><span>@Text["Cases"]</span>
                            </NavLink>
                            <NavLink href="disbursements/admin/events" class="nav-item level-2" @onclick="NotifyNavigation">
                                <span class="nav-icon bi-calendar-event"></span><span>@Text["Events"]</span>
                            </NavLink>
                        }
                    }
                </div>
            }

            @if (isAuthenticated && canAccessMemberManagement) {
                <div class="nav-section">
                    <button type="button" class="nav-section-toggle nav-item level-1 @(isMemberManagementExpanded ? "active" : null)" @onclick="ToggleMemberManagementExpanded">
                        <span class="nav-icon bi-shield-lock-fill"></span>
                        @Text["MemberManagement"]
                        <span class="nav-chevron bi @(isMemberManagementExpanded ? "bi-chevron-up" : "bi-chevron-down")"></span>
                    </button>

                    @if (isMemberManagementExpanded)
                    {
                        @if (canReadMembers)
                        {
                        <NavLink href="member-management/members" class="nav-item level-2" @onclick="NotifyNavigation">
                            <span class="nav-icon bi-people-fill"></span>
                            <span>@Text["Members"]</span>
                        </NavLink>
                        }

                        @if (canReadMembers)
                        {
                        <NavLink href="member-management/trial" class="nav-item level-2" @onclick="NotifyNavigation">
                            <span class="nav-icon bi-hourglass-split"></span>
                            <span>@Text["Trial"]</span>
                        </NavLink>
                        }
                        
                        @if (canAccessRequests)
                        {
                        <NavLink href="member-management/requests" class="nav-item level-2" @onclick="NotifyNavigation">
                            <span class="nav-icon bi-envelope-fill"></span>
                            <span>@Text["Requests"]</span>
                        </NavLink>
                        }

                        @if (canAccessDues)
                        {
                        <NavLink href="member-management/dues" class="nav-item level-2" @onclick="NotifyNavigation">
                            <span class="nav-icon bi-cash-stack"></span>
                            <span>@Text["Dues"]</span>
                        </NavLink>
                        }
                        @if (canReadMembers)
                        {
                        <NavLink href="member-management/audit-log" class="nav-item level-2" @onclick="NotifyNavigation">
                            <span class="nav-icon bi-journal-text"></span>
                            <span>@Text["AuditLog"]</span>
                        </NavLink>
                        }
                    }
                </div>
            }

            @if (isAuthenticated && canManageInvoices)
            {
                <div class="nav-section">
                    <button type="button" class="nav-section-toggle nav-item level-1 @(isInvoicesExpanded ? "active" : null)" @onclick="ToggleInvoicesExpanded">
                        <span class="nav-icon bi-receipt"></span>
                        @Text["Invoices"]
                        <span class="nav-chevron bi @(isInvoicesExpanded ? "bi-chevron-up" : "bi-chevron-down")"></span>
                    </button>

                    @if (isInvoicesExpanded)
                    {
                        <NavLink href="invoices/manage" class="nav-item level-2" @onclick="NotifyNavigation">
                            <span class="nav-icon bi-file-earmark-text"></span>
                            <span>@Text["Invoices"]</span>
                        </NavLink>

                        <NavLink href="invoices/presets" class="nav-item level-2" @onclick="NotifyNavigation">
                            <span class="nav-icon bi-collection"></span>
                            <span>@Text["Presets"]</span>
                        </NavLink>
                    }
                </div>
            }
            
            @if (isAuthenticated && canAccessIdentity)
            {
                <div class="nav-section">
                    <button type="button" class="nav-section-toggle nav-item level-1 @(isIdentityExpanded ? "active" : null)" @onclick="ToggleIdentityExpanded">
                        <span class="nav-icon bi-person-fill-lock"></span>
                        @Text["Identity"]
                        <span class="nav-chevron bi @(isIdentityExpanded ? "bi-chevron-up" : "bi-chevron-down")"></span>
                    </button>

                    @if (isIdentityExpanded)
                    {
                        @if (canManageOidc)
                        {
                        <NavLink href="identity/clients" class="nav-item level-2" @onclick="NotifyNavigation">
                            <span class="nav-icon bi-window-stack"></span>
                            <span>@Text["Clients"]</span>
                        </NavLink>

                        <NavLink href="identity/scopes" class="nav-item level-2" @onclick="NotifyNavigation">
                            <span class="nav-icon bi-diagram-3"></span>
                            <span>@Text["Scopes"]</span>
                        </NavLink>
                        }

                        @if (canReadRoles)
                        {
                        <NavLink href="identity/roles" class="nav-item level-2" @onclick="NotifyNavigation">
                            <span class="nav-icon bi-person-badge-fill"></span>
                            <span>@Text["Roles"]</span>
                        </NavLink>
                        }

                        @if (canReadUsers)
                        {
                        <NavLink href="identity/users" class="nav-item level-2" @onclick="NotifyNavigation">
                            <span class="nav-icon bi-person-gear"></span>
                            <span>@Text["Users"]</span>
                        </NavLink>
                        }
                        
                        @if (canReadIdentityAudit)
                        {
                        <NavLink href="identity/audit-log" class="nav-item level-2" @onclick="NotifyNavigation">
                            <span class="nav-icon bi-journal-text"></span>
                            <span>@Text["AuditLog"]</span>
                        </NavLink>
                        }
                    }
                </div>
            }

            @if (isAuthenticated && canAccessIdentity && isDebug) {
                <div class="nav-section">
                    @if (isDebugExpanded)
                    {
                        <NavLink href="debug" class="nav-item level-2" @onclick="NotifyNavigation">
                            <span class="nav-icon bi-diagram-3-fill"></span>
                            <span>API</span>
                        </NavLink>
                    }
                </div>
            }
        </nav>
    </div>
    <div class="sidebar-footer">
        <div class="preference-switchers">
            <ThemeSwitcherBox AriaLabel="@Text["Theme_AriaLabel"]"
                              SystemTitle="@Text["Theme_System"]"
                              LightTitle="@Text["Theme_Light"]"
                              DarkTitle="@Text["Theme_Dark"]" />
            <LanguageSwitcher />
        </div>
        <UserBox IdentityUrl="@IdentityUrl" />
    </div>
</div>
