@page "/disbursements/admin/events/{EventId:guid}"
@using Microsoft.AspNetCore.Authorization
@using AkGaming.Management.Modules.Disbursements.Contracts.Enums
@attribute [Authorize(Policy = "management.disbursements.read")]

<PageTitle>@PageText["Page_DisbursementEvent_Title"]</PageTitle>
<div class="event-page ui-stack-md">
    <a class="back-link" href="disbursements/admin/events"><span class="bi bi-arrow-left"></span> @Text["Events_Title"]</a>
    @if (!string.IsNullOrWhiteSpace(_error)) { <p class="error">@_error</p> }
    @if (_event is null) { <p>@SharedText["State_Loading"]</p> }
    else
    {
        <section class="panel heading"><div><h3>@_event.Name</h3><p>@_event.Description</p><small>@_event.OccurredOn?.ToString("d")</small></div><AuthorizeView Policy="management.disbursements.manage"><button type="button" class="primary-action" @onclick="OpenCreateDialogAsync" disabled="@_busy"><span class="bi bi-plus-lg"></span> @Text["Event_AddAllocation"]</button></AuthorizeView></section>
        @if (_event.Allocations.Count == 0) { <section class="panel empty">@Text["Event_NoAllocations"]</section> }
        @foreach (var allocation in _event.Allocations)
        {
            <section class="panel allocation-card ui-stack-md">
                <header>
                    <div><h4>@allocation.Name</h4><p>@allocation.Description</p></div>
                    <div class="allocation-actions">
                        <strong>@allocation.Amount.ToString("N2") EUR</strong>
                        <AuthorizeView Policy="management.disbursements.manage">
                            <ContextMenu AriaLabel="@($"{SharedText["Action_Edit"]} {allocation.Name}")">
                                <ContextMenuItem IconClass="bi-pencil" Text="@SharedText["Action_Edit"]" OnClick="() => OpenEditDialogAsync(allocation)" />
                            </ContextMenu>
                        </AuthorizeView>
                    </div>
                </header>
                <div class="share-row"><input readonly value="@ShareUrl(allocation)" /><button type="button" @onclick="() => CopyAsync(ShareUrl(allocation))"><span class="bi bi-copy"></span> @Text["Event_CopyClaimLink"]</button><a href="@($"disbursements/claim/{allocation.ShareToken}")" target="_blank">@SharedText["Action_Open"]</a></div>
                @if (!string.IsNullOrWhiteSpace(allocation.DiscordChannelId))
                {
                    <small class="discord-route"><span class="bi bi-discord"></span> #@allocation.DiscordChannelName · @($"@{allocation.DiscordRoleName}")</small>
                }
                <div class="allocation-progress"><span style="width:@Progress(allocation)%"></span></div><small>@allocation.AppliedAmount.ToString("N2") EUR applied · @(AvailableAmount(allocation).ToString("N2")) EUR available</small>
                @if (allocation.Applications.Count == 0) { <p class="ui-text-muted">@Text["Event_NoApplications"]</p> }
                @foreach (var application in allocation.Applications)
                {
                    <article class="application-row"><div><strong>@application.ApplicantName</strong><button type="button" class="payment-details-button" @onclick="() => ShowPaymentDetails(application.PaymentMethod)"><span class="bi bi-credit-card"></span> @application.PaymentMethod.DisplayName <span class="bi bi-box-arrow-up-right"></span></button><small>@application.Approvals.Count(a => a.IsApproved) approval(s), @application.Approvals.Count(a => !a.IsApproved) objection(s)</small></div><strong>@application.Amount.ToString("N2") EUR</strong><AuthorizeView Policy="management.disbursements.manage"><Authorized><InputSelect TValue="AllocationApplicationStatus" Value="application.Status" ValueChanged="status => SetStatusAsync(application, status)" ValueExpression="() => application.Status" disabled="@_busy">@foreach (var status in Enum.GetValues<AllocationApplicationStatus>()) { <option value="@status">@status.ToLocalizedString(SharedText)</option> }</InputSelect></Authorized><NotAuthorized><span>@application.Status.ToLocalizedString(SharedText)</span></NotAuthorized></AuthorizeView></article>
                }
            </section>
        }
    }
</div>

@if (_discordCatalog is not null)
{
    <CreateAllocationDialog @key="_editingAllocation?.Id" Catalog="_discordCatalog" CatalogReady="_discordCatalogReady" Allocation="_editingAllocation" Busy="_busy" Error="_dialogError" OnSubmit="SaveAllocationAsync" OnClose="CloseAllocationDialog" />
}

@if (_selectedPaymentMethod is not null)
{
    <PaymentMethodDetailsDialog PaymentMethod="_selectedPaymentMethod" OnClose="HidePaymentDetails" />
}
