@page "/disbursements/admin/reimbursements"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "management.disbursements.read")]

<PageTitle>@PageText["Page_ReimbursementsAdmin_Title"]</PageTitle>

<div class="admin-disbursements ui-stack-md">
    <section class="panel heading">
        <div><h3 class="ui-title">@PageText["Page_ReimbursementsAdmin_Title"]</h3><p class="ui-text-muted">@PageText["Page_ReimbursementsAdmin_Description"]</p></div>
        <button type="button" class="secondary-action" @onclick="LoadAsync" disabled="@_busy"><span class="bi bi-arrow-clockwise"></span>@SharedText["Action_Refresh"]</button>
    </section>
    @if (!string.IsNullOrWhiteSpace(_error)) { <p class="error-message">@_error</p> }
    @if (_items is null) { <p>@SharedText["State_Loading"]</p> }
    else if (_items.Count == 0) { <section class="panel empty">@Text["Reimbursements_AdminNone"]</section> }
    else
    {
        <div class="filters">
            <label>@SharedText["Field_Status"]<InputSelect @bind-Value="_filter"><option value="">@SharedText["State_All"]</option>@foreach (var status in Enum.GetValues<AkGaming.Management.Modules.Disbursements.Contracts.Enums.DisbursementStatus>()) { <option value="@status">@status.ToLocalizedString(SharedText)</option> }</InputSelect></label>
        </div>
        @foreach (var item in FilteredItems)
        {
            <ReimbursementCard @key="item.Id" Item="item" Administrative="true" Disabled="@_busy" OnDownload="DownloadReceiptAsync" OnStatusChanged="request => UpdateStatusAsync(item, request)" />
        }
    }
</div>
