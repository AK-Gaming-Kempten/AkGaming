@page "/disbursements/admin/events"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "management.disbursements.read")]

<PageTitle>@PageText["Page_DisbursementEvents_Title"]</PageTitle>
<div class="events-page ui-stack-md">
    <section class="panel heading"><div><h3 class="ui-title">@Text["Events_Title"]</h3><p class="ui-text-muted">@Text["Events_Description"]</p></div><AuthorizeView Policy="management.disbursements.manage"><button type="button" class="primary-action" @onclick="() => _showCreate = !_showCreate"><span class="bi bi-plus-lg"></span> @Text["Events_New"]</button></AuthorizeView></section>
    @if (!string.IsNullOrWhiteSpace(_error)) { <p class="error">@_error</p> }
    @if (_showCreate)
    {
        <AuthorizeView Policy="management.disbursements.manage"><section class="panel create-form"><h4>@Text["Events_New"]</h4><label>@SharedText["Field_Name"]<InputText @bind-Value="_newEvent.Name" disabled="@_busy" /></label><label>@SharedText["Field_Date"]<InputDate @bind-Value="_newEvent.OccurredOn" disabled="@_busy" /></label><label>@SharedText["Field_Description"]<InputTextArea @bind-Value="_newEvent.Description" disabled="@_busy" /></label><button type="button" class="primary-action" @onclick="CreateAsync" disabled="@_busy"><span class="bi bi-floppy"></span> @Text["Events_Create"]</button></section></AuthorizeView>
    }
    @if (_events is null) { <p>@SharedText["State_Loading"]</p> }
    else if (_events.Count == 0) { <section class="panel empty">@Text["Events_None"]</section> }
    else
    {
        <div class="event-grid">
            @foreach (var item in _events)
            {
                <a class="panel event-card" href="@($"disbursements/admin/events/{item.Id}")">
                    <span class="bi bi-trophy"></span><div><h4>@item.Name</h4><p>@item.Description</p><small>@(item.OccurredOn?.ToString("d") ?? Text["Events_NoDate"]) · @item.Allocations.Count allocation(s) · @item.Allocations.Sum(a => a.Amount).ToString("N2") EUR</small></div><span class="bi bi-chevron-right"></span>
                </a>
            }
        </div>
    }
</div>
