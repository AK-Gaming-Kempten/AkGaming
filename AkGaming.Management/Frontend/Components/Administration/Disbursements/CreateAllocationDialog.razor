<div class="dialog-backdrop" role="presentation">
    <section class="allocation-dialog" role="dialog" aria-modal="true" aria-labelledby="allocation-dialog-title">
        <header>
            <h4 id="allocation-dialog-title">@Text[Allocation is null ? "Event_AddAllocation" : "Event_EditAllocation"]</h4>
            <button type="button" title="@SharedText["Action_Close"]" @onclick="OnClose"><span class="bi bi-x-lg"></span></button>
        </header>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <p class="error">@Error</p>
        }

        <div class="form-fields">
            <label>@SharedText["Field_Name"]<InputText @bind-Value="_model.Name" disabled="@Busy" /></label>
            <label>@SharedText["Field_Amount"] (EUR)<InputNumber @bind-Value="_model.Amount" min="0.01" step="0.01" disabled="@Busy" /></label>
            <label>@SharedText["Field_Description"]<InputTextArea @bind-Value="_model.Description" disabled="@Busy" /></label>
            <p class="field-hint">@Text["Allocation_DiscordOptional"]</p>
            <label>@Text["Allocation_DiscordChannel"]
                <InputSelect @bind-Value="_model.DiscordChannelId" disabled="@Busy">
                    <option value="">@Text["Allocation_SelectDiscordChannel"]</option>
                    @foreach (var channel in Catalog.Channels)
                    {
                        <option value="@channel.Id">@channel.Name</option>
                    }
                </InputSelect>
            </label>
            <label>@Text["Allocation_DiscordRole"]
                <InputSelect @bind-Value="_model.DiscordRoleId" disabled="@Busy">
                    <option value="">@Text["Allocation_SelectDiscordRole"]</option>
                    @foreach (var role in Catalog.Roles)
                    {
                        <option value="@role.Id">@role.Name</option>
                    }
                </InputSelect>
            </label>
        </div>

        <footer>
            <button type="button" class="secondary-action" @onclick="OnClose" disabled="@Busy">@SharedText["Action_Cancel"]</button>
            <button type="button" class="primary-action" @onclick="SubmitAsync" disabled="@(Busy || !CanSubmit)">@Text[Allocation is null ? "Event_CreateAllocation" : "Event_SaveAllocation"]</button>
        </footer>
    </section>
</div>
