<button type="@ButtonType"
        class="btn action-button @VariantClass @SizeClass @CssClass"
        disabled="@Disabled"
        title="@EffectiveLabel"
        aria-label="@EffectiveLabel"
        @onclick="OnClick"
        @onblur="OnBlur">
    <span class="bi @IconClass" aria-hidden="true"></span>
</button>
