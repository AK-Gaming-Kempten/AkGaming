<div class="pager">
    <ActionButton Kind="ActionButtonKind.Previous" OnClick="OnPreviousClicked" Disabled="_isPrevDisabled" Label="Previous page" />
    <span>Page @Page of @TotalPages (Total @TotalCount)</span>
    <ActionButton Kind="ActionButtonKind.Next" OnClick="OnNextClicked" Disabled="_isNextDisabled" Label="Next page" />
</div>

@code {
    [Parameter]
    public int Page { get; set; } = 1;

    [Parameter]
    public int TotalPages { get; set; } = 1;

    [Parameter]
    public int TotalCount { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public EventCallback OnPrevious { get; set; }

    [Parameter]
    public EventCallback OnNext { get; set; }

    private bool _isPrevDisabled => IsBusy || Page <= 1;
    private bool _isNextDisabled => IsBusy || Page >= TotalPages;

    private Task OnPreviousClicked() => OnPrevious.InvokeAsync();
    private Task OnNextClicked() => OnNext.InvokeAsync();
}
