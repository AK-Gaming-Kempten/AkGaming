@page "/identity/roles"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "identity.roles.read")]

<PageTitle>Identity Roles</PageTitle>

<div class="identity-roles-page mobile-master-detail @(_isMobileDetailOpen ? "mobile-detail-open" : string.Empty)">
    <div class="roles-list-pane">
        <div class="pane-header">
            <h4>Roles</h4>
            <ActionButton Kind="ActionButtonKind.Refresh" OnClick="ReloadAsync" Label="Refresh roles" />
        </div>

        @if (_canManageRoles)
        {
        <div class="create-role card">
            <label for="new-role-name">Create role</label>
            <div class="inline-controls">
                <InputText id="new-role-name" @bind-Value="_newRoleName" placeholder="Role name" />
                <ActionButton Kind="ActionButtonKind.Create" Variant="ActionButtonVariant.Primary" OnClick="CreateRoleAsync" Disabled="_isBusy" Label="Create role" />
            </div>
        </div>
        }

        <div class="roles-list card">
            @if (_roles is null)
            {
                <p>Loading roles...</p>
            }
            else if (_roles.Count == 0)
            {
                <p>No roles found.</p>
            }
            else
            {
                @foreach (var role in _roles.OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase))
                {
                    <button type="button"
                            class="role-item @(role.Id == _selectedRoleId ? "selected" : string.Empty)"
                            @onclick="() => SelectRole(role)">
                        <span>@role.Name</span>
                        <small>@role.Id</small>
                    </button>
                }
            }
        </div>
    </div>

    <div class="role-editor-pane card">
        <div class="mobile-detail-nav">
            <ActionButton Kind="ActionButtonKind.Back" Variant="ActionButtonVariant.Outline" Size="ActionButtonSize.Small" OnClick="ShowListMobile" Label="Back to roles" />
        </div>
        <h4>Role Details</h4>

        @if (_selectedRole is null)
        {
            <p>Select a role to rename or delete it.</p>
        }
        else
        {
            <div class="form-col">
                <label>Role Id</label>
                <input value="@_selectedRole.Id.ToString()" disabled />
            </div>

            <div class="form-col">
                <label for="rename-role-name">Role name</label>
                <InputText id="rename-role-name" @bind-Value="_renameRoleName" />
            </div>

            @if (_canManageRoles)
            {
            <div class="editor-actions">
                <ActionButton Kind="ActionButtonKind.Save" Variant="ActionButtonVariant.Primary" OnClick="RenameRoleAsync" Disabled="_isBusy" Label="Save role name" />
                <ActionButton Kind="ActionButtonKind.Delete" Variant="ActionButtonVariant.Danger" OnClick="DeleteRoleAsync" Disabled="_isBusy" Label="Delete role" />
            </div>
            }

            <div class="form-col permission-editor">
                <label>Permissions</label>
                @if (_permissions is null)
                {
                    <p>Loading permissions...</p>
                }
                else
                {
                    <div class="permission-groups">
                        @foreach (var application in GetPermissionApplications())
                        {
                            <section class="permission-application">
                                <h5>@ToDisplayText(application.Key)</h5>
                                @foreach (var area in application.GroupBy(permission => permission.Area).OrderBy(group => group.Key, StringComparer.Ordinal))
                                {
                                    <div class="permission-area">
                                        <h6>@ToDisplayText(area.Key)</h6>
                                        <div class="permission-options">
                                            @foreach (var permission in area.OrderBy(permission => permission.Operation, StringComparer.Ordinal))
                                            {
                                                <label class="permission-option @(IsSelectedRoleSystemRole ? "disabled" : string.Empty)"
                                                       title="@permission.Description">
                                                    <input type="checkbox"
                                                           checked="@_selectedPermissionKeys.Contains(permission.Key)"
                                                           disabled="@(IsSelectedRoleSystemRole || !_canManageRoles)"
                                                           aria-label="@($"{permission.Key}: {permission.Description}")"
                                                           @onchange="args => SetPermissionSelection(permission.Key, args.Value)" />
                                                    <span class="permission-checkmark" aria-hidden="true"></span>
                                                    <span>@ToDisplayText(permission.Operation)</span>
                                                </label>
                                            }
                                        </div>
                                    </div>
                                }
                            </section>
                        }
                    </div>
                    @if (_canManageRoles)
                    {
                        <ActionButton Kind="ActionButtonKind.Save" Variant="ActionButtonVariant.Primary" OnClick="SavePermissionsAsync" Disabled="@(_isBusy || IsSelectedRoleSystemRole)" Label="Save permissions" />
                    }
                    @if (IsSelectedRoleSystemRole)
                    {
                        <small>System role permissions are managed by the application.</small>
                    }
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <p class="text-danger">@_error</p>
        }

        @if (!string.IsNullOrWhiteSpace(_success))
        {
            <p class="text-success">@_success</p>
        }
    </div>
</div>
