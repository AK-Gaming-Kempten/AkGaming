@using AkGaming.Identity.Contracts.Auth

<article class="panel identity-entry">
    <header class="identity-entry-summary">
        <div class="identity-entry-heading">
            <strong>@Client.DisplayName</strong>
            <span class="ui-text-muted">@Client.ClientId</span>
        </div>

        <div class="identity-entry-meta">
            <span class="identity-entry-chip">@Client.ClientType</span>
            <span class="identity-entry-chip">@Client.ConsentType</span>
            <span class="identity-entry-chip">@Client.Scopes.Length scope@(Client.Scopes.Length == 1 ? string.Empty : "s")</span>
            <span class="identity-entry-chip">@Client.RedirectUris.Length redirect@(Client.RedirectUris.Length == 1 ? string.Empty : "s")</span>
            @if (Client.HasClientSecret)
            {
                <span class="identity-entry-chip">secret configured</span>
            }
            @if (Client.RequirePkce)
            {
                <span class="identity-entry-chip">PKCE</span>
            }
            @if (Client.AllowAuthorizationCodeFlow)
            {
                <span class="identity-entry-chip">authorization code</span>
            }
            @if (Client.AllowClientCredentialsFlow)
            {
                <span class="identity-entry-chip">client credentials</span>
            }
            @if (Client.AllowRefreshTokenFlow)
            {
                <span class="identity-entry-chip">refresh tokens</span>
            }
            @if (Client.IsProtected)
            {
                <span class="identity-entry-chip identity-entry-chip-protected">protected</span>
            }
        </div>

        <ActionButton Kind="@(EditMode ? ActionButtonKind.Close : ActionButtonKind.Edit)" Size="ActionButtonSize.Small" OnClick="ToggleEditMode" Disabled="IsBusy" Label="@(EditMode ? "Close client editor" : "Edit client")" />
    </header>

    @if (EditMode)
    {
        <div class="ui-divider-top-dashed identity-entry-editor">
            @if (Client.IsProtected)
            {
                <p class="text-warning">@GetProtectionMessage()</p>
            }

            <div class="ui-grid-auto-180">
                <div class="ui-field">
                    <label>Display name</label>
                    <InputText @bind-Value="_displayName" disabled="@Client.IsProtected" />
                </div>

                <div class="ui-field">
                    <label>Client type</label>
                    <InputSelect @bind-Value="_clientType" disabled="@Client.IsProtected">
                        <option value="confidential">confidential</option>
                        <option value="public">public</option>
                    </InputSelect>
                </div>

                <div class="ui-field">
                    <label>Consent type</label>
                    <InputSelect @bind-Value="_consentType" disabled="@(Client.IsProtected || !_allowAuthorizationCodeFlow)">
                        <option value="implicit">implicit</option>
                        <option value="explicit">explicit</option>
                        <option value="external">external</option>
                        <option value="systematic">systematic</option>
                    </InputSelect>
                </div>
            </div>

            @if (string.Equals(_clientType, "confidential", StringComparison.OrdinalIgnoreCase))
            {
                <div class="ui-field">
                    <label>Replace client secret</label>
                    <InputText @bind-Value="_clientSecret" type="password" autocomplete="new-password" placeholder="Leave empty to keep current secret" disabled="@Client.IsProtected" />
                </div>
            }

            <div class="identity-entry-grid-wide">
                <div class="ui-field">
                    <label>Redirect URIs</label>
                    <InputTextArea @bind-Value="_redirectUrisText" disabled="@(Client.IsProtected || !_allowAuthorizationCodeFlow)" />
                </div>

                <div class="ui-field">
                    <label>Post logout redirect URIs</label>
                    <InputTextArea @bind-Value="_postLogoutRedirectUrisText" disabled="@(Client.IsProtected || !_allowAuthorizationCodeFlow)" />
                </div>

                <div class="ui-field">
                    <label>Scopes</label>
                    <InputTextArea @bind-Value="_scopesText" disabled="@Client.IsProtected" />
                </div>
            </div>

            <div class="identity-entry-options">
                <label class="role-checkbox">
                    <InputCheckbox @bind-Value="_allowAuthorizationCodeFlow" disabled="@Client.IsProtected" />
                    <span>Authorization code flow</span>
                </label>
                <label class="role-checkbox">
                    <InputCheckbox @bind-Value="_allowClientCredentialsFlow" disabled="@Client.IsProtected" />
                    <span>Client credentials flow</span>
                </label>
                <label class="role-checkbox">
                    <InputCheckbox @bind-Value="_requirePkce" disabled="@(Client.IsProtected || !_allowAuthorizationCodeFlow)" />
                    <span>Require PKCE</span>
                </label>
                <label class="role-checkbox">
                    <InputCheckbox @bind-Value="_allowRefreshTokenFlow" disabled="@(Client.IsProtected || !_allowAuthorizationCodeFlow)" />
                    <span>Allow refresh token flow</span>
                </label>
            </div>

            @if (_allowClientCredentialsFlow)
            {
                <p class="ui-text-muted">Client credentials requires a confidential client. Redirect URIs, consent, PKCE, and refresh tokens are only used by authorization code flow.</p>
            }

            <div class="ui-actions">
                <ActionButton Kind="ActionButtonKind.Save" Variant="ActionButtonVariant.Primary" Size="ActionButtonSize.Small" OnClick="SaveAsync" Disabled="@(IsBusy || Client.IsProtected)" Label="Save client" />
                <ActionButton Kind="ActionButtonKind.Delete" Variant="ActionButtonVariant.Danger" Size="ActionButtonSize.Small" OnClick="DeleteAsync" Disabled="@(IsBusy || Client.IsProtected)" Label="Delete client" />
                <ActionButton Kind="ActionButtonKind.Cancel" Variant="ActionButtonVariant.Outline" Size="ActionButtonSize.Small" OnClick="CancelEditing" Disabled="IsBusy" />
            </div>
        </div>
    }
</article>
