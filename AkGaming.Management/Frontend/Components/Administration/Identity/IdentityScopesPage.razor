@page "/identity/scopes"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "identity.oidc.manage")]

<PageTitle>@PageText["Page_IdentityScopes_Title"]</PageTitle>

<div class="ui-stack-md identity-admin-page">
    <section class="panel identity-admin-card">
        <div class="identity-admin-toolbar">
            <h4 class="ui-title">@PageText["Page_IdentityScopes_Title"]</h4>
            <div class="ui-actions">
                <ActionButton Kind="ActionButtonKind.Refresh" Size="ActionButtonSize.Small" OnClick="ReloadAsync" Disabled="_isBusy" Label="@SharedText["Action_Refresh"]" />
                <ActionButton Kind="@(_showCreateForm ? ActionButtonKind.Cancel : ActionButtonKind.Create)" Variant="ActionButtonVariant.Outline" Size="ActionButtonSize.Small" OnClick="ToggleCreateForm" Label="@(_showCreateForm ? "Hide create scope" : "Create scope")" />
            </div>
        </div>

        @if (_showCreateForm)
        {
            <div class="ui-divider-top-dashed identity-create-form">
                <div class="ui-grid-auto-180">
                    <div class="ui-field">
                        <label for="new-scope-name">@SharedText["Field_ScopeName"]</label>
                        <InputText id="new-scope-name" @bind-Value="_newScopeName" placeholder="akgaming.api" />
                    </div>

                    <div class="ui-field">
                        <label for="new-scope-display-name">@SharedText["Field_DisplayName"]</label>
                        <InputText id="new-scope-display-name" @bind-Value="_newDisplayName" placeholder="AK Gaming API" />
                    </div>
                </div>

                <div class="ui-field">
                    <label for="new-scope-description">@SharedText["Field_Description"]</label>
                    <InputTextArea id="new-scope-description" @bind-Value="_newDescription" placeholder="Describe what the scope grants access to" />
                </div>

                <div class="ui-field">
                    <label for="new-scope-resources">@SharedText["Field_Resources"]</label>
                    <InputTextArea id="new-scope-resources" @bind-Value="_newResourcesText" placeholder="One resource per line" />
                </div>

                <div class="ui-actions">
                    <ActionButton Kind="ActionButtonKind.Create" Variant="ActionButtonVariant.Primary" Size="ActionButtonSize.Small" OnClick="CreateScopeAsync" Disabled="_isBusy" Label="@SharedText["Action_Create"]" />
                    <ActionButton Kind="ActionButtonKind.Cancel" Variant="ActionButtonVariant.Outline" Size="ActionButtonSize.Small" OnClick="ToggleCreateForm" Disabled="_isBusy" />
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <p class="text-danger">@_error</p>
        }

        @if (!string.IsNullOrWhiteSpace(_success))
        {
            <p class="text-success">@_success</p>
        }
    </section>

    <section class="panel identity-admin-card">
        <h4 class="ui-title">@SharedText["Heading_ExistingScopes"]</h4>

        @if (_scopes is null)
        {
            <p>@SharedText["State_LoadingScopes"]</p>
        }
        else if (_scopes.Count == 0)
        {
            <p>@SharedText["State_NoScopes"]</p>
        }
        else
        {
            <div class="ui-list identity-entry-list">
                @foreach (var scope in SortedScopes)
                {
                    <IdentityScopeEntry @key="scope.Name"
                                        Scope="scope"
                                        IsBusy="_isBusy"
                                        OnSave="SaveScopeAsync"
                                        OnDelete="DeleteScopeAsync" />
                }
            </div>
        }
    </section>
</div>
