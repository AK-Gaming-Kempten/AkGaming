@page "/identity/clients"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "identity.oidc.manage")]

<PageTitle>@PageText["Page_IdentityClients_Title"]</PageTitle>

<div class="ui-stack-md identity-admin-page">
    <section class="panel identity-admin-card">
        <div class="identity-admin-toolbar">
            <h4 class="ui-title">@PageText["Page_IdentityClients_Title"]</h4>
            <div class="ui-actions">
                <ActionButton Kind="ActionButtonKind.Refresh" Size="ActionButtonSize.Small" OnClick="ReloadAsync" Disabled="_isBusy" Label="@SharedText["Action_Refresh"]" />
                <ActionButton Kind="@(_showCreateForm ? ActionButtonKind.Cancel : ActionButtonKind.Create)" Variant="ActionButtonVariant.Outline" Size="ActionButtonSize.Small" OnClick="ToggleCreateForm" Label="@(_showCreateForm ? "Hide create client" : "Create client")" />
            </div>
        </div>

        @if (_showCreateForm)
        {
            <div class="ui-divider-top-dashed identity-create-form">
                <div class="ui-actions">
                    <ActionButton Kind="ActionButtonKind.Update" Variant="ActionButtonVariant.Outline" Size="ActionButtonSize.Small" OnClick="UseInteractiveClientDefaults" Disabled="_isBusy" Label="Interactive client defaults" />
                    <ActionButton Kind="ActionButtonKind.Update" Variant="ActionButtonVariant.Outline" Size="ActionButtonSize.Small" OnClick="UseServiceClientDefaults" Disabled="_isBusy" Label="Service client defaults" />
                    <ActionButton Kind="ActionButtonKind.Update" Variant="ActionButtonVariant.Outline" Size="ActionButtonSize.Small" OnClick="UseGamelyBotDefaults" Disabled="_isBusy" Label="GamelyBot defaults" />
                </div>

                <div class="ui-grid-auto-180">
                    <div class="ui-field">
                        <label for="new-client-id">@SharedText["Field_ClientId"]</label>
                        <InputText id="new-client-id" @bind-Value="_newClientId" placeholder="frontend-app" />
                    </div>

                    <div class="ui-field">
                        <label for="new-display-name">@SharedText["Field_DisplayName"]</label>
                        <InputText id="new-display-name" @bind-Value="_newDisplayName" placeholder="Frontend App" />
                    </div>

                    <div class="ui-field">
                        <label for="new-client-type">@SharedText["Field_ClientType"]</label>
                        <InputSelect id="new-client-type" @bind-Value="_newClientType">
                            <option value="confidential">confidential</option>
                            <option value="public">public</option>
                        </InputSelect>
                    </div>

                    <div class="ui-field">
                        <label for="new-consent-type">@SharedText["Field_ConsentType"]</label>
                        <InputSelect id="new-consent-type" @bind-Value="_newConsentType" disabled="@(!_newAllowAuthorizationCodeFlow)">
                            <option value="implicit">implicit</option>
                            <option value="explicit">explicit</option>
                            <option value="external">external</option>
                            <option value="systematic">systematic</option>
                        </InputSelect>
                    </div>
                </div>

                @if (string.Equals(_newClientType, "confidential", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="ui-field">
                        <label for="new-client-secret">@SharedText["Field_ClientSecret"]</label>
                        <InputText id="new-client-secret" @bind-Value="_newClientSecret" type="password" autocomplete="new-password" placeholder="Required for confidential clients" />
                    </div>
                }

                <div class="identity-grid-wide">
                    <div class="ui-field">
                        <label for="new-client-redirects">@SharedText["Field_RedirectUris"]</label>
                        <InputTextArea id="new-client-redirects" @bind-Value="_newRedirectUrisText" placeholder="One URI per line" disabled="@(!_newAllowAuthorizationCodeFlow)" />
                    </div>

                    <div class="ui-field">
                        <label for="new-client-post-logout-redirects">@SharedText["Field_PostLogoutUris"]</label>
                        <InputTextArea id="new-client-post-logout-redirects" @bind-Value="_newPostLogoutRedirectUrisText" placeholder="One URI per line" disabled="@(!_newAllowAuthorizationCodeFlow)" />
                    </div>

                    <div class="ui-field">
                        <label for="new-client-scopes">Scopes</label>
                        <InputTextArea id="new-client-scopes" @bind-Value="_newScopesText" placeholder="One scope per line" />
                    </div>
                </div>

                <div class="identity-create-options">
                    <label class="role-checkbox">
                        <InputCheckbox @bind-Value="_newAllowAuthorizationCodeFlow" />
                        <span>Authorization code flow</span>
                    </label>
                    <label class="role-checkbox">
                        <InputCheckbox @bind-Value="_newAllowClientCredentialsFlow" />
                        <span>Client credentials flow</span>
                    </label>
                    <label class="role-checkbox">
                        <InputCheckbox @bind-Value="_newRequirePkce" disabled="@(!_newAllowAuthorizationCodeFlow)" />
                        <span>Require PKCE</span>
                    </label>
                    <label class="role-checkbox">
                        <InputCheckbox @bind-Value="_newAllowRefreshTokenFlow" disabled="@(!_newAllowAuthorizationCodeFlow)" />
                        <span>Allow refresh token flow</span>
                    </label>
                </div>

                <p class="ui-text-muted">Service clients should be confidential, use client credentials only, and have no redirect URIs, PKCE, refresh tokens, or interactive user scopes.</p>

                <div class="ui-actions">
                    <ActionButton Kind="ActionButtonKind.Create" Variant="ActionButtonVariant.Primary" Size="ActionButtonSize.Small" OnClick="CreateClientAsync" Disabled="_isBusy" Label="@SharedText["Action_Create"]" />
                    <ActionButton Kind="ActionButtonKind.Cancel" Variant="ActionButtonVariant.Outline" Size="ActionButtonSize.Small" OnClick="ToggleCreateForm" Disabled="_isBusy" />
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <p class="text-danger">@_error</p>
        }

        @if (!string.IsNullOrWhiteSpace(_success))
        {
            <p class="text-success">@_success</p>
        }
    </section>

    <section class="panel identity-admin-card">
        <h4 class="ui-title">@SharedText["Heading_ExistingClients"]</h4>

        @if (_clients is null)
        {
            <p>@SharedText["State_LoadingClients"]</p>
        }
        else if (_clients.Count == 0)
        {
            <p>@SharedText["State_NoClients"]</p>
        }
        else
        {
            <div class="ui-list identity-entry-list">
                @foreach (var client in SortedClients)
                {
                    <IdentityClientEntry @key="client.ClientId"
                                         Client="client"
                                         IsBusy="_isBusy"
                                         OnSave="SaveClientAsync"
                                         OnDelete="DeleteClientAsync" />
                }
            </div>
        }
    </section>
</div>
