@page "/invoices/payment-terms"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Invoice Payment Terms Presets</PageTitle>

<div class="invoice-payment-presets-page ui-stack-md">
    <section class="panel invoice-payment-presets-toolbar">
        <div>
            <h3 class="ui-title">Payment terms presets</h3>
            <span class="ui-text-muted">Reusable payment instructions for invoice editing.</span>
        </div>
        <button type="button" class="btn btn-primary" @onclick="ToggleCreate" disabled="@_isBusy">
            @(_showCreate ? "Cancel creation" : "Create preset")
        </button>
    </section>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <p class="text-danger">@_error</p>
    }
    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <p class="text-success">@_status</p>
    }

    <div class="invoice-payment-presets-layout two-column-layout mobile-master-detail @(_isMobileDetailOpen ? "mobile-detail-open" : string.Empty)">
        <section class="panel preset-list-pane two-column-layout-left">
            <h4 class="ui-title">Presets</h4>
            @if (_presets is null)
            {
                <p>Loading presets...</p>
            }
            else if (_presets.Count == 0)
            {
                <p>No payment terms presets have been created.</p>
            }
            else
            {
                <div class="list-scroll-container">
                    <div class="invoice-payment-preset-list preview-card-list">
                    @foreach (var preset in _presets)
                    {
                        <button type="button"
                                class="invoice-payment-preset-entry @(preset.Id == _editingPreset.Id ? "invoice-payment-preset-entry-active" : string.Empty)"
                                @onclick="() => SelectPreset(preset)">
                            <strong>@preset.Label</strong>
                            <span>@GetPreview(preset.Terms)</span>
                        </button>
                    }
                    </div>
                </div>
            }
        </section>

        <section class="preset-detail-pane two-column-layout-right">
            <div class="mobile-detail-nav">
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ShowListMobile">
                    <span class="bi bi-arrow-left" aria-hidden="true"></span>
                    Back to payment terms
                </button>
            </div>
            @if (_showCreate || _editingPreset.Id != Guid.Empty)
            {
            <PaymentTermsPresetForm Title="@(_showCreate ? "New preset" : "Edit preset")"
                                    Model="_editingPreset"
                                    IsBusy="_isBusy"
                                    ShowDelete="@(!_showCreate)"
                                    OnSave="SaveAsync"
                                    OnDelete="DeleteAsync"
                                    OnCancel="ShowListMobile" />
            }
        </section>
    </div>
</div>
