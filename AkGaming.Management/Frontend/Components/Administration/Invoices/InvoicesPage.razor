@page "/invoices/manage"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "management.invoices.manage")]

<PageTitle>@PageText["Page_Invoices_Title"]</PageTitle>

<Toast Visible="@(!string.IsNullOrWhiteSpace(_error))"
       AppName="AK Gaming Management"
       Title="Invoice error"
       Message="@_error"
       Variant="ToastVariant.Error"
       OnDismiss="DismissError" />

<div class="invoice-page ui-stack-md">
    <section class="panel invoice-page-toolbar">
        <div>
            <h3 class="ui-title">@PageText["Page_Invoices_Title"]</h3>
            <span class="ui-text-muted">@PageText["Page_Invoices_Description"]</span>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <p class="text-success">@_status</p>
    }

    <div class="invoice-page-layout two-column-layout mobile-master-detail @(_isMobileDetailOpen ? "mobile-detail-open" : string.Empty)">
        <aside class="panel invoice-selector two-column-layout-left">
            <div class="list-buttons">
                <h4 class="ui-title">@Text["Invoices_Stored"]</h4>
                <ActionButton Kind="ActionButtonKind.Refresh" OnClick="ReloadAsync" Disabled="_isBusy" Label="@SharedText["Action_Refresh"]" />
                <ActionButton Kind="ActionButtonKind.Create" Variant="ActionButtonVariant.Primary" OnClick="StartCreate" Disabled="_isBusy" Label="@SharedText["Action_Create"]" />
            </div>
            @if (_invoices is null)
            {
                <p>@Text["Invoices_Loading"]</p>
            }
            else if (_invoices.Count == 0)
            {
                <p>@Text["Invoices_None"]</p>
            }
            else
            {
                <div class="list-scroll-container">
                    <div class="invoice-selector-list preview-card-list">
                        @foreach (var invoice in _invoices)
                        {
                            <button type="button"
                                    class="invoice-selector-entry @(invoice.Id == _selectedInvoice?.Id ? "invoice-selector-entry-active" : string.Empty)"
                                    @onclick="() => SelectInvoiceAsync(invoice.Id)"
                                    disabled="@_isBusy">
                                <strong>@invoice.InvoiceNumber</strong>
                                <span>@invoice.BuyerName</span>
                                <small>@invoice.InvoiceDate.ToString("d") - @invoice.TotalAmount.ToString("N2") EUR</small>
                            </button>
                        }
                    </div>
                </div>
            }
        </aside>

        <main class="invoice-detail two-column-layout-right">
            <div class="mobile-detail-nav">
                <ActionButton Kind="ActionButtonKind.Back" Variant="ActionButtonVariant.Outline" Size="ActionButtonSize.Small" OnClick="ShowListMobile" Label="@SharedText["Action_BackToList"]" />
            </div>
            @if (_selectedInvoice is not null)
            {
                <InvoiceEditor @key="_selectedInvoice.Id"
                               Model="_selectedInvoice"
                               Presets="_presets"
                               PaymentTermsPresets="_paymentTermsPresets"
                               BankAccountPresets="_bankAccountPresets"
                               LineItemPresets="_lineItemPresets"
                               LineItemCollectionPresets="_lineItemCollectionPresets"
                               IsBusy="_isBusy"
                               OnSave="SaveAsync"
                               OnDelete="DeleteAsync"
                               OnError="ShowError"
                               OnCancel="CloseEditor" />
            }
            else
            {
                <section class="panel invoice-empty-state">
                    <h4>@Text["Invoices_Select"]</h4>
                    <p>@Text["Invoices_SelectHelp"]</p>
                </section>
            }
        </main>
    </div>
</div>
