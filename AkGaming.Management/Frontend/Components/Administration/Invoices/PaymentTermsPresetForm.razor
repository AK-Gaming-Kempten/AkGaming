@using AkGaming.Management.Modules.InvoiceManagement.Contracts.DTO

<section class="panel payment-terms-preset-form ui-stack-md">
    <h4 class="ui-title">@Title</h4>
    <div class="ui-field">
        <label>Preset label</label>
        <InputText @bind-Value="Model.Label" />
    </div>
    <div class="ui-field">
        <label>Payment terms</label>
        <InputTextArea @bind-Value="Model.Terms" />
    </div>
    <div class="ui-actions">
        <ActionButton Kind="ActionButtonKind.Save" Variant="ActionButtonVariant.Primary" OnClick="SaveAsync" Disabled="IsBusy" Label="Save payment terms preset" />
        @if (ShowDelete)
        {
            <ActionButton Kind="ActionButtonKind.Delete" Variant="ActionButtonVariant.Danger" OnClick="DeleteAsync" Disabled="IsBusy" Label="Delete payment terms preset" />
        }
        @if (OnCancel.HasDelegate)
        {
            <ActionButton Kind="ActionButtonKind.Cancel" Variant="ActionButtonVariant.Outline" OnClick="CancelAsync" Disabled="IsBusy" />
        }
    </div>
</section>
