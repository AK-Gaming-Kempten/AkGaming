<section class="panel ui-stack-md"><h4 class="ui-title">@Title</h4><div class="ui-field"><label>@Text["Presets_Label"]</label><InputText @bind-Value="Model.Label" /></div><div class="ui-grid-auto-180"><div class="ui-field"><label>@SharedText["Field_Description"]</label><InputText @bind-Value="Model.LineItem.Description" /></div><div class="ui-field"><label>@Text["Invoice_UnitPrice"]</label><InputNumber @bind-Value="Model.LineItem.UnitPrice" /></div><div class="ui-field"><label>@Text["Invoice_Quantity"]</label><InputNumber @bind-Value="Model.LineItem.Quantity" /></div></div><div class="ui-actions"><ActionButton Kind="ActionButtonKind.Save" Variant="ActionButtonVariant.Primary" OnClick="SaveAsync" Disabled="IsBusy" Label="@SharedText["Action_Save"]" />@if (ShowDelete) { <ActionButton Kind="ActionButtonKind.Delete" Variant="ActionButtonVariant.Danger" OnClick="DeleteAsync" Disabled="IsBusy" Label="@SharedText["Action_Delete"]" /> }</div></section>
