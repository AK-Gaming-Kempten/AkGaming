<section class="panel ui-stack-md"><h4 class="ui-title">@Title</h4><div class="ui-field"><label>Preset label</label><InputText @bind-Value="Model.Label" /></div><div class="ui-grid-auto-180"><div class="ui-field"><label>Description</label><InputText @bind-Value="Model.LineItem.Description" /></div><div class="ui-field"><label>Unit price</label><InputNumber @bind-Value="Model.LineItem.UnitPrice" /></div><div class="ui-field"><label>Quantity</label><InputNumber @bind-Value="Model.LineItem.Quantity" /></div></div><div class="ui-actions"><button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@IsBusy">Save preset</button>@if (ShowDelete) { <button type="button" class="btn btn-danger" @onclick="DeleteAsync" disabled="@IsBusy">Delete preset</button> }</div></section>
