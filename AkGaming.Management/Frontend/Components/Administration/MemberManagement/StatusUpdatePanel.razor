@using global::AkGaming.Management.Modules.MemberManagement.Contracts.Enums
<div class="status-section">
    @if (Member is null) {
            <em>@SharedText["State_LoadingMembers"]</em>
    } else {
            <h4>@SharedText["Heading_StatusHistory"]</h4>
            
            @if (Editable) {
                <div class="status-tabs">
                    <button type="button"
                            class="tab @( _activeTab == StatusTab.SetStatus ? "active" : "" )"
                            @onclick="() => _activeTab = StatusTab.SetStatus">
                        @SharedText["Field_NewStatus"]
                    </button>
                    <button type="button"
                            class="tab @( _activeTab == StatusTab.InsertEvent ? "active" : "" )"
                            @onclick="() => _activeTab = StatusTab.InsertEvent">
                        @SharedText["Action_InsertStatusEvent"]
                    </button>
                </div>

                <div class="status-forms">
                    @if (_activeTab == StatusTab.SetStatus) {
                        <!-- Form A: Set current status -->
                        <div class="form-grid">
                            <div class="form-col">
                                <label>@SharedText["Field_NewStatus"]</label>
                                <InputSelect @bind-Value="_updateStatus">
                                    @foreach (var s in Enum.GetValues<MembershipStatus>()) {
                                        <option value="@s">@s.ToLocalizedString(SharedText)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="form-col" style="align-self:end;">
                                <ActionButton Kind="ActionButtonKind.Update" Variant="ActionButtonVariant.Primary" OnClick="UpdateStatusAsync" Disabled="@(_updateStatus == MembershipStatus.None)" Label="@SharedText["Action_Update"]" />
                            </div>
                        </div>
                    } else if (_activeTab == StatusTab.InsertEvent) {
                        <!-- Form B: Insert a status-change event (manual entry) -->
                        <div class="form-grid">
                            <div class="form-col">
                                <label>@SharedText["Field_OldStatus"]</label>
                                <InputSelect @bind-Value="_insertModel.OldStatus">
                                    @foreach (var s in Enum.GetValues<MembershipStatus>()) {
                                        <option value="@s">@s.ToLocalizedString(SharedText)</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="form-col">
                                <label>@SharedText["Field_NewStatus"]</label>
                                <InputSelect @bind-Value="_insertModel.NewStatus">
                                    @foreach (var s in Enum.GetValues<MembershipStatus>()) {
                                        <option value="@s">@s.ToLocalizedString(SharedText)</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="form-col">
                                <label>@SharedText["Field_Timestamp"]</label>
                                <InputDate @bind-Value="_insertModel.Timestamp" />
                            </div>

                            <div class="form-col" style="align-self:end;">
                                <ActionButton Kind="ActionButtonKind.Add" Variant="ActionButtonVariant.Primary" OnClick="InsertStatusChangeEventAsync" Disabled="@(_insertModel.NewStatus == MembershipStatus.None || _insertModel.Timestamp == DateTime.MinValue)" Label="@SharedText["Action_Add"]" />
                            </div>
                        </div>
                    }
                </div>
            }
            
            <div class="status-history">
                @if (_statusChanges is null) {
                    <p>@SharedText["State_LoadingHistory"]</p>
                } else if (!_statusChanges.Any()) {
                    <em>@SharedText["State_NoHistory"]</em>
                } else {
                    <ul class="status-list">
                        @foreach (var evt in _statusChanges.OrderByDescending(e => e.Timestamp)) {
                            <li>
                                <strong>@evt.NewStatus.ToLocalizedString(SharedText)</strong><br />
                                <small>@evt.Timestamp.ToString("g")</small>
                            </li>
                        }
                    </ul>
                }
            </div>
    }
</div>
