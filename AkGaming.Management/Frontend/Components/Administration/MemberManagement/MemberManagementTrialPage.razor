@page "/member-management/trial"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "management.members.read")]

<PageTitle>@PageText["Page_TrialMembers_Title"]</PageTitle>

<div class="two-column-layout mobile-master-detail @(_isMobileDetailOpen ? "mobile-detail-open" : string.Empty)">
    <div class="two-column-layout-left">
        <div class="list-buttons">
            <h4>@SharedText["Heading_TrialMembers"]</h4>
            <ActionButton Kind="ActionButtonKind.Refresh" Variant="ActionButtonVariant.Primary" OnClick="LoadTrialMembersAsync" Label="@SharedText["Action_Refresh"]" />
        </div>
        <div class="list-main">
            <p class="trial-queue-hint">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                @SharedText["TrialQueue_ManualDecisionHint"]
            </p>
            @if (_isLoading)
            {
                <p>@SharedText["State_LoadingTrialMembers"]</p>
            }
            else if (!string.IsNullOrWhiteSpace(_loadError))
            {
                <p class="text-danger">@_loadError</p>
            }
            else if (_trialMembers.Count == 0)
            {
                <p>@SharedText["State_NoTrialMembers"]</p>
            }
            else
            {
                <div class="list-scroll-container">
                    <div class="preview-card-list">
                        @foreach (var trialMember in _trialMembers)
                        {
                            var member = trialMember.Member;
                            var trial = GetTrialInfo(trialMember);

                            <div class="member-preview-card trial-member-preview @(member.Id == _selectedMember?.Id ? "selected" : "")"
                                 @onclick="() => SelectMember(member)">
                                <div class="member-preview-card-content">
                                    <div>@member.LastName, @member.FirstName</div>
                                    <div>@member.DiscordUserName</div>

                                    @if (trial.HasError)
                                    {
                                        <div class="trial-remaining trial-error">@SharedText["TrialQueue_PeriodUnavailable"]</div>
                                    }
                                    else
                                    {
                                        <div class="trial-remaining">
                                            @if (trial.IsExpired)
                                            {
                                                <span class="expired-badge">@SharedText["TrialQueue_Overdue"]</span>
                                                <span>@SharedText["TrialQueue_EndedOn", trial.EndDate.ToString("d")]</span>
                                            }
                                            else if (trial.DaysRemaining == 0)
                                            {
                                                <span>@SharedText["TrialQueue_DueToday"]</span>
                                                <span class="trial-end-date">(@trial.EndDate.ToString("d"))</span>
                                            }
                                            else if (trial.DaysRemaining == 1)
                                            {
                                                <span>@SharedText["TrialQueue_OneDayRemaining"]</span>
                                                <span class="trial-end-date">(@SharedText["TrialQueue_Until", trial.EndDate.ToString("d")])</span>
                                            }
                                            else
                                            {
                                                <span>@SharedText["TrialQueue_DaysRemaining", trial.DaysRemaining]</span>
                                                <span class="trial-end-date">(@SharedText["TrialQueue_Until", trial.EndDate.ToString("d")])</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="two-column-layout-right">
        <div class="mobile-detail-nav">
            <ActionButton Kind="ActionButtonKind.Back" Variant="ActionButtonVariant.Outline" Size="ActionButtonSize.Small" OnClick="ShowListMobile" Label="@SharedText["Action_BackToList"]" />
        </div>
        <CascadingValue Value="MemberApi" Name="MemberManagementApi" IsFixed="true">
            <MemberCard Member="_selectedMember" IsEditable="_canManageMemberDetails" IsStatusEditable="_canManageMemberStatus" OnMemberUpdated="ReloadAfterUpdate" />
        </CascadingValue>
    </div>
</div>
