@using global::AkGaming.Management.Modules.MemberManagement.Contracts.Enums
<div class="member-card readonly-mode">
    @if (Request is null) {
        <div class="no-request-selected">@SharedText["State_NoSelection"]</div>
    }
    else {
        <div class="member-card-content">
            <div class="form-wrapper">
                <div class="form-section">
                    <div class="form-grid">
                        <div class="form-col">
                            <label>@SharedText["Field_FirstName"]</label>
                            <InputText @bind-Value="Request.FirstName" readonly="true" />
                        </div>
                        <div class="form-col">
                            <label>@SharedText["Field_LastName"]</label>
                            <InputText @bind-Value="Request.LastName" readonly="true" />
                        </div>

                        <div class="form-col">
                            <label>@SharedText["Field_Email"]</label>
                            <InputText @bind-Value="Request.Email" readonly="true" />
                        </div>
                        <div class="form-col">
                            <label>@SharedText["Field_Discord"]</label>
                            <InputText @bind-Value="Request.DiscordUserName" readonly="true" />
                        </div>
                        
                        <div class="form-col">
                            <label>@SharedText["Field_Reason"]</label>
                            <div>
                                @Request.Reason.ToString()
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @if (IsEditable && !Request.IsResolved) {
                <div class="list-main">
                    <div class="list-scroll-container">
                        <div class="preview-card-list">
                            @foreach (var member in _members!) {
                                <MemberPreviewCard Member="member" IsSelected="member == _selectedMember" OnSelect="SelectMember"/>
                            }
                        </div>
                    </div>
                </div>
                <div class="form-actions">
                    <ActionButton Kind="ActionButtonKind.Link" Variant="ActionButtonVariant.Primary" OnClick="Link" Disabled="@(_selectedMember == null)" Label="@SharedText["Action_Link"]" />
                    <ActionButton Kind="ActionButtonKind.Reject" Variant="ActionButtonVariant.Danger" OnClick="Reject" Label="@SharedText["Action_Reject"]" />
                </div>  
            }
        </div>
    }
</div>
