<div class="member-card readonly-mode">
    @if (Request is null)
    {
        <div class="no-request-selected">@SharedText["State_NoSelection"]</div>
    }
    else
    {
        <div class="member-card-content">
            @if (IsEditable && !Request.IsResolved) {
                <div class="form-actions">
                    <ActionButton Kind="ActionButtonKind.Approve" Variant="ActionButtonVariant.Primary" OnClick="Approve" Label="@SharedText["Action_Approve"]" />
                    <ActionButton Kind="ActionButtonKind.Reject" Variant="ActionButtonVariant.Danger" OnClick="Reject" Label="@SharedText["Action_Reject"]" />
                </div>
            }
            
            <div class="form-wrapper">
                <div class="form-section">
                    <div class="form-grid">
                        <div class="form-col">
                            <label>@SharedText["Field_FirstName"]</label>
                            <InputText @bind-Value="Request.MemberCreationInfo.FirstName" readonly="true" />
                        </div>
                        <div class="form-col">
                            <label>@SharedText["Field_LastName"]</label>
                            <InputText @bind-Value="Request.MemberCreationInfo.LastName" readonly="true" />
                        </div>

                        <div class="form-col">
                            <label>@SharedText["Field_Email"]</label>
                            <InputText @bind-Value="Request.MemberCreationInfo.Email" readonly="true" />
                        </div>
                        <div class="form-col">
                            <label>@SharedText["Field_Phone"]</label>
                            <InputText @bind-Value="Request.MemberCreationInfo.Phone" readonly="true" />
                        </div>

                        <div class="form-col">
                            <label>@SharedText["Field_Discord"]</label>
                            <InputText @bind-Value="Request.MemberCreationInfo.DiscordUserName" readonly="true" />
                        </div>
                        <div class="form-col">
                            <label>@SharedText["Field_BirthDate"]</label>
                            <InputDate @bind-Value="Request.MemberCreationInfo.BirthDate" readonly="true" />
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h4>@SharedText["Field_Address"]</h4>
                    <div class="form-grid">
                        <div class="form-col">
                            <label>@SharedText["Field_Street"]</label>
                            <InputText @bind-Value="Request.MemberCreationInfo.Address!.Street" readonly="true" />
                        </div>
                        <div class="form-col">
                            <label>@SharedText["Field_PostalCode"]</label>
                            <InputText @bind-Value="Request.MemberCreationInfo.Address!.ZipCode" readonly="true" />
                        </div>
                        <div class="form-col">
                            <label>@SharedText["Field_City"]</label>
                            <InputText @bind-Value="Request.MemberCreationInfo.Address!.City" readonly="true" />
                        </div>
                        <div class="form-col">
                            <label>@SharedText["Field_Country"]</label>
                            <InputText @bind-Value="Request.MemberCreationInfo.Address!.Country" readonly="true" />
                        </div>
                    </div>
                </div>
                <div class="form-section">
                    <div class="form-col">
                        <label>@SharedText["Field_ApplicationMessage"]</label>
                        <InputText @bind-Value="Request.ApplicationText" readonly="true" />
                    </div>
                </div>
            </div>
        </div>
    }
</div>
