@page "/member-management/dues"
@using Microsoft.AspNetCore.Authorization
@using AkGaming.Management.Modules.MemberManagement.Contracts.DTO
@using AkGaming.Management.Modules.MemberManagement.Contracts.Enums
@attribute [Authorize(Policy = "management.dues.read")]

<PageTitle>@PageText["Page_MemberDues_Title"]</PageTitle>

<div class="dues-management-page-shell">
    <div class="ui-stack-md dues-management-page @(_isReminderDialogOpen || _isSuspensionDialogOpen ? "dues-management-page-dialog-open" : string.Empty)"
         inert="@(_isReminderDialogOpen || _isSuspensionDialogOpen ? string.Empty : null)"
         aria-hidden="@(_isReminderDialogOpen || _isSuspensionDialogOpen ? "true" : null)">
        @if (!string.IsNullOrWhiteSpace(_statusMessage)) {
            <p class="status-message">@_statusMessage</p>
        }
        @if (!string.IsNullOrWhiteSpace(_errorMessage)) {
            <p class="text-danger">@_errorMessage</p>
        }

        @if (_selectedPaymentPeriodId is null) {
            <section class="panel dues-card payment-period-list-state">
                <div class="dues-list-header">
                    <div>
                        <h4 class="ui-title">@SharedText["Heading_PaymentPeriods"]</h4>
                        <p class="ui-text-muted">@SharedText["Message_SelectPaymentPeriod"]</p>
                    </div>
                    <div class="ui-actions">
                        <ActionButton Kind="ActionButtonKind.Refresh" Size="ActionButtonSize.Small" OnClick="() => LoadPaymentPeriodsAsync()" Disabled="_loadingPaymentPeriods" Label="@SharedText["Action_Refresh"]" />
                        @if (_canManageDues) {
                            <ActionButton Kind="@(_showCreatePeriodForm ? ActionButtonKind.Cancel : ActionButtonKind.Create)"
                                          Variant="ActionButtonVariant.Primary"
                                          Size="ActionButtonSize.Small"
                                          OnClick="ToggleCreatePeriodForm"
                                          Label="@(_showCreatePeriodForm ? SharedText["Action_Cancel"] : SharedText["Action_CreatePeriod"])" />
                        }
                    </div>
                </div>

                @if (_canManageDues && _showCreatePeriodForm) {
                    <EditForm Model="_createRequest" OnValidSubmit="CreatePaymentPeriodAsync" class="payment-period-create-form">
                        <div class="ui-grid-auto-180 dues-create-grid">
                            <div>
                                <label>@SharedText["Field_Name"]</label>
                                <InputText @bind-Value="_createRequest.Name" />
                            </div>
                            <div>
                                <label>@SharedText["Field_DueDate"]</label>
                                <InputDate @bind-Value="_createRequest.DueDate" />
                            </div>
                            <div>
                                <label>@SharedText["Field_DefaultAmount"]</label>
                                <InputNumber @bind-Value="_createRequest.DefaultDueAmount" />
                            </div>
                            <div>
                                <label>@SharedText["Field_ReducedAmount"]</label>
                                <InputNumber @bind-Value="_createRequest.ReducedDueAmount" />
                            </div>
                        </div>
                        <ActionButton Kind="ActionButtonKind.Create" Variant="ActionButtonVariant.Primary" Size="ActionButtonSize.Small" ButtonType="submit" Disabled="_creatingPeriod" Label="@SharedText["Action_Create"]" />
                    </EditForm>
                }

                @if (_loadingPaymentPeriods) {
                    <p>@SharedText["State_Loading"]</p>
                }
                else if (_paymentPeriods.Count == 0) {
                    <p>@SharedText["State_NoPaymentPeriods"]</p>
                }
                else {
                    <PaymentPeriodList Periods="_paymentPeriods"
                                       IsBusy="_loadingPaymentPeriods"
                                       OnSelect="SelectPaymentPeriodAsync" />
                }
            </section>
        }
        else {
            <section class="panel dues-card payment-period-detail-header">
                <div>
                    <ActionButton Kind="ActionButtonKind.Back" Variant="ActionButtonVariant.Outline" Size="ActionButtonSize.Small" OnClick="ShowPaymentPeriodList" Label="@SharedText["Action_BackToList"]" />
                    <h3 class="ui-title">@SelectedPaymentPeriod?.Name</h3>
                    <p class="ui-text-muted">
                        @SharedText["Field_DueDate"]: @SelectedPaymentPeriod?.DueDate.ToString("d")
                        · @SharedText["Field_DefaultAmount"]: @SelectedPaymentPeriod?.DefaultDueAmount.ToString("N2")
                        · @SharedText["Field_ReducedAmount"]: @SelectedPaymentPeriod?.ReducedDueAmount.ToString("N2")
                    </p>
                </div>
                <div class="ui-actions">
                    <ActionButton Kind="ActionButtonKind.Refresh" Size="ActionButtonSize.Small" OnClick="() => LoadPaymentPeriodsAsync(true)" Disabled="@(_loadingPaymentPeriods || _loadingDues)" Label="@SharedText["Action_Refresh"]" />
                    @if (_canDispatchDues) {
                        <ActionButton Kind="ActionButtonKind.Send" Variant="ActionButtonVariant.Primary" Size="ActionButtonSize.Small" OnClick="OpenBulkReminderDialogAsync" Disabled="@(_loadingPaymentPeriods || _loadingDues)" Label="@SharedText["Action_Send"]" />
                    }
                </div>
            </section>

            <div class="ui-grid-2 dues-top-grid">
                <section class="panel dues-card dues-controls-card">
                    <h4 class="ui-title">@SharedText["Heading_Controls"]</h4>
                    <div class="ui-grid-auto-160 dues-toolbar">
                        <div class="ui-field dues-control">
                            <label for="member-display-mode">@SharedText["Field_MemberDisplay"]</label>
                            <InputSelect id="member-display-mode" class="ui-select-sm" @bind-Value="_memberDisplayMode">
                                <option value="@MemberDisplayMode.FullName">@SharedText["Field_FullName"]</option>
                                <option value="@MemberDisplayMode.MemberId">@SharedText["Field_MemberId"]</option>
                            </InputSelect>
                        </div>
                        <div class="ui-field dues-control">
                            <label for="member-name-filter">@SharedText["Action_FilterByName"]</label>
                            <InputText id="member-name-filter" class="ui-input-sm" placeholder="@SharedText["Placeholder_SearchMember"]" @bind-Value="_memberNameFilter" />
                        </div>
                        <div class="ui-field dues-control">
                            <label for="status-filter">@SharedText["Action_FilterByStatus"]</label>
                            <InputSelect id="status-filter" class="ui-select-sm" @bind-Value="_selectedStatusFilter">
                                <option value="">@SharedText["Field_AllStatuses"]</option>
                                @foreach (var status in Enum.GetValues<MembershipDueStatus>()) {
                                    <option value="@status">@status.ToLocalizedString(SharedText)</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </section>

                <section class="panel dues-card dues-summary-card">
                    <h4 class="ui-title">@SharedText["Heading_Summary"]</h4>
                    <div class="dues-dashboard">
                        <div class="dues-half-pie-shell">
                            <div class="dues-half-pie" style="@GetHalfPieStyle()">
                                <div class="dues-half-pie-inner">
                                    <strong>@TotalCount</strong>
                                    <span>@SharedText["Heading_TotalDues"]</span>
                                </div>
                            </div>
                        </div>
                        <div class="dues-summary">
                            <span class="dues-chip dues-chip-open">@SharedText["Status_Open"]: @PendingCount</span>
                            <span class="dues-chip dues-chip-paid">@SharedText["Status_Paid"]: @PaidCount</span>
                            <span class="dues-chip dues-chip-waived">@SharedText["Status_Waived"]: @WaivedCount</span>
                            <span class="dues-chip dues-chip-cancelled">@SharedText["Status_Cancelled"]: @CancelledCount</span>
                        </div>
                    </div>
                </section>
            </div>

            <section class="panel dues-card dues-list-card">
                <div class="dues-list-header">
                    <h4 class="ui-title">@SharedText["Heading_PaymentPeriodDues"]</h4>
                    @if (_canDispatchDues) {
                        <ActionButton Kind="ActionButtonKind.Send" Variant="ActionButtonVariant.Primary" Size="ActionButtonSize.Small" OnClick="OpenBulkReminderDialogAsync" Disabled="@(_loadingPaymentPeriods || _loadingDues)" Label="@SharedText["Action_Send"]" />
                    }
                </div>
                @if (_loadingPaymentPeriods || _loadingDues) {
                    <p>@SharedText["State_LoadingDues"]</p>
                }
                else if (_dues.Count == 0) {
                    <p>@SharedText["State_NoDues"]</p>
                }
                else {
                    <div class="ui-list dues-entry-list">
                        @foreach (var due in FilteredAndSortedDues) {
                            <MemberDueEntry Due="@due"
                                            PrimaryMemberLabel="@GetPrimaryMemberLabel(due.MemberId)"
                                            SecondaryMemberLabel="@GetSecondaryMemberLabel(due.MemberId)"
                                            IsSaving="@_savingDueIds.Contains(due.Id)"
                                            CanManage="_canManageDues"
                                            CanDispatch="_canDispatchDues"
                                            OnSave="SaveDueAsync"
                                            OnRequestReminderSend="OpenSingleReminderDialogAsync"
                                            OnRequestSuspensionSend="OpenSuspensionDialogAsync" />
                        }
                    </div>
                }
            </section>
        }
    </div>

    @if (_isReminderDialogOpen) {
        <div class="dues-reminder-dialog-backdrop"></div>
        <div class="dues-reminder-dialog-shell" role="dialog" aria-modal="true" aria-labelledby="dues-reminder-dialog-title">
            <section class="panel dues-reminder-dialog">
                <header class="dues-reminder-dialog-header">
                    <div>
                        <p class="dues-reminder-dialog-eyebrow">@SharedText["Heading_ReminderDispatch"]</p>
                        <h3 id="dues-reminder-dialog-title">@ReminderDialogTitle</h3>
                    </div>
                    <ActionButton Kind="ActionButtonKind.Close" Variant="ActionButtonVariant.Outline" Size="ActionButtonSize.Small" OnClick="CloseReminderDialog" Disabled="_sendingReminderDispatch" Label="@SharedText["Action_Close"]" />
                </header>

                @if (_loadingReminderDispatchPreview) {
                    <p>Loading reminder dispatch preview...</p>
                }
                else if (!string.IsNullOrWhiteSpace(_reminderDialogError)) {
                    <p class="text-danger">@_reminderDialogError</p>
                }
                else if (_reminderDispatchPreview is not null) {
                    <div class="dues-reminder-dialog-summary">
                        <span class="dues-chip dues-chip-open">Recipients: @_reminderDispatchPreview.Recipients.Count</span>
                        <span class="dues-chip dues-chip-cancelled">Skipped: @_reminderDispatchPreview.SkippedMembers.Count</span>
                        @if (_sendingReminderDispatchCompleted) {
                            <span class="dues-chip dues-chip-paid">Sent: @ReminderDispatchSuccessCount</span>
                            <span class="dues-chip dues-chip-cancelled">Failed: @ReminderDispatchFailureCount</span>
                        }
                    </div>

                    <div class="dues-reminder-dialog-columns">
                        <section class="dues-reminder-card">
                            <h4>@SharedText["Field_Recipients"]</h4>
                            @if (_dispatchRecipientStates.Count == 0) {
                                <p>@SharedText["State_NoReminderRecipients"]</p>
                            }
                            else {
                                <div class="dues-reminder-list">
                                    @foreach (var recipient in _dispatchRecipientStates) {
                                        <article class="dues-reminder-list-item">
                                            <div>
                                                <strong>@recipient.MemberDisplayName</strong>
                                                <p>@recipient.Email</p>
                                                <p>Due: @recipient.DueAmount.ToString("0.00") € · Due date: @recipient.DueDate</p>
                                                @if (!string.IsNullOrWhiteSpace(recipient.ResultMessage)) {
                                                    <p class="@(recipient.State == ReminderDispatchState.Failed ? "text-danger" : "status-message")">@recipient.ResultMessage</p>
                                                }
                                            </div>
                                            <span class="@GetReminderStateClass(recipient.State)">@GetReminderStateLabel(recipient.State)</span>
                                            @if (_canDispatchDues) {
                                                <ActionButton Kind="ActionButtonKind.DownloadPdf"
                                                              Size="ActionButtonSize.Small"
                                                              OnClick="() => DownloadReminderPdfAsync(recipient)"
                                                              Disabled="@(_downloadingReminderPdfIds.Contains(recipient.DueId) || _sendingReminderDispatch)"
                                                              Label="@($"Download reminder PDF for {recipient.MemberDisplayName}")" />
                                            }
                                        </article>
                                    }
                                </div>
                            }
                        </section>

                        <section class="dues-reminder-card">
                            <h4>Will not receive mail</h4>
                            @if (_reminderDispatchPreview.SkippedMembers.Count == 0) {
                                <p>@SharedText["State_NoSkippedMembers"]</p>
                            }
                            else {
                                <div class="dues-reminder-list">
                                    @foreach (var skippedMember in _reminderDispatchPreview.SkippedMembers) {
                                        <article class="dues-reminder-list-item dues-reminder-list-item-skip">
                                            <div>
                                                <strong>@skippedMember.MemberDisplayName</strong>
                                                <p>@skippedMember.Reason</p>
                                            </div>
                                        </article>
                                    }
                                </div>
                            }
                        </section>
                    </div>

                    <footer class="dues-reminder-dialog-actions">
                        @if (_canDispatchDues && !_sendingReminderDispatchCompleted && _dispatchRecipientStates.Count > 0) {
                            <ActionButton Kind="ActionButtonKind.Send" Variant="ActionButtonVariant.Primary" OnClick="SendReminderDispatchAsync" Disabled="@(_sendingReminderDispatch || _loadingReminderDispatchPreview)" Label="@SharedText["Action_Send"]" />
                        }
                        <ActionButton Kind="@(_sendingReminderDispatchCompleted || _dispatchRecipientStates.Count == 0 ? ActionButtonKind.Close : ActionButtonKind.Cancel)" OnClick="CloseReminderDialog" Disabled="_sendingReminderDispatch" Label="@(_sendingReminderDispatchCompleted || _dispatchRecipientStates.Count == 0 ? "Close" : "Cancel")" />
                    </footer>
                }
            </section>
        </div>
    }

    @if (_isSuspensionDialogOpen) {
        <div class="dues-reminder-dialog-backdrop"></div>
        <div class="dues-reminder-dialog-shell" role="dialog" aria-modal="true" aria-labelledby="dues-suspension-dialog-title">
            <section class="panel dues-reminder-dialog">
                <header class="dues-reminder-dialog-header">
                    <div>
                        <p class="dues-reminder-dialog-eyebrow">@SharedText["Heading_SuspensionMail"]</p>
                        <h3 id="dues-suspension-dialog-title">@SuspensionDialogTitle</h3>
                    </div>
                    <ActionButton Kind="ActionButtonKind.Close" Variant="ActionButtonVariant.Outline" Size="ActionButtonSize.Small" OnClick="CloseSuspensionDialog" Disabled="_sendingSuspension" Label="@SharedText["Action_Close"]" />
                </header>

                @if (_loadingSuspensionPreview) {
                    <p>Loading suspension preview...</p>
                }
                else if (!string.IsNullOrWhiteSpace(_suspensionDialogError)) {
                    <p class="text-danger">@_suspensionDialogError</p>
                }
                else if (_suspensionPreview is not null) {
                    <div class="dues-reminder-dialog-summary">
                        <span class="dues-chip dues-chip-open">Recipient: @_suspensionPreview.RecipientDisplayName</span>
                        <span class="dues-chip dues-chip-cancelled">Status will change to Suspended</span>
                    </div>

                    <div class="due-email-preview">
                        <div class="due-email-preview-meta">
                            <div>
                                <label>@SharedText["Field_Recipient"]</label>
                                <div class="due-email-preview-value">@_suspensionPreview.RecipientDisplayName (@_suspensionPreview.RecipientEmail)</div>
                            </div>
                            <div>
                                <label>@SharedText["Field_Subject"]</label>
                                <div class="due-email-preview-value">@_suspensionPreview.Subject</div>
                            </div>
                        </div>

                        <div class="due-email-preview-sections">
                            <div class="due-email-preview-section">
                                <label>@SharedText["Field_FallbackText"]</label>
                                <textarea class="due-email-preview-text" readonly>@_suspensionPreview.TextBody</textarea>
                            </div>

                            <div class="due-email-preview-section">
                                <label>@SharedText["Field_HtmlPreview"]</label>
                                <div class="due-email-preview-render">@SuspensionHtmlPreview</div>
                            </div>
                        </div>
                    </div>

                    <footer class="dues-reminder-dialog-actions">
                        @if (_canDispatchDues) {
                            <ActionButton Kind="ActionButtonKind.DownloadPdf" Variant="ActionButtonVariant.Primary" OnClick="DownloadSuspensionPdfAsync" Disabled="@(_downloadingSuspensionPdf || _loadingSuspensionPreview)" Label="@SharedText["Action_Download"]" />
                            <ActionButton Kind="ActionButtonKind.Send" Variant="ActionButtonVariant.Danger" OnClick="SendSuspensionAsync" Disabled="@(_sendingSuspension || _loadingSuspensionPreview)" Label="@SharedText["Action_Send"]" />
                        }
                        <ActionButton Kind="ActionButtonKind.Cancel" OnClick="CloseSuspensionDialog" Disabled="_sendingSuspension" />
                    </footer>
                }
            </section>
        </div>
    }
</div>
