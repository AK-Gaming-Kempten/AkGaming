@page "/member-management/members"
<PageTitle>@PageText["Page_Members_Title"]</PageTitle>
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "management.members.read")]
@inject HttpClient Api

<div class="two-column-layout mobile-master-detail @(_isMobileDetailOpen ? "mobile-detail-open" : string.Empty)">
    <div class="two-column-layout-left">
        <div class="list-buttons">
            <h4>@SharedText["Heading_ExistingMembers"]</h4>
            <ActionButton Kind="ActionButtonKind.Filter" OnClick="OpenFilters" Disabled="true" Label="@SharedText["Action_Filter"]" />
            @if (_canManageMemberDetails)
            {
                <ActionButton Kind="ActionButtonKind.Create" Variant="ActionButtonVariant.Primary" OnClick="CreateMember" Label="@SharedText["Action_Create"]" />
            }
        </div>
        <div class="list-main">
            @if (_members == null)
            {
                <p>@SharedText["State_Loading"]</p>
            }
            else if (!_members.Any())
            {
                <p>@SharedText["State_NoMembers"]</p>
            }
            else
            {
                <div class="list-scroll-container">
                    <div class="preview-card-list">
                        @foreach (var member in _members)
                        {
                            <MemberPreviewCard Member="member" IsSelected="member == _selectedMember" OnSelect="SelectMember"/>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="two-column-layout-right">
        <div class="mobile-detail-nav">
            <ActionButton Kind="ActionButtonKind.Back" Variant="ActionButtonVariant.Outline" Size="ActionButtonSize.Small" OnClick="ShowListMobile" Label="@SharedText["Action_BackToList"]" />
        </div>
        <CascadingValue Value="MemberApi" Name="MemberManagementApi" IsFixed="true">
            <MemberCard Member="_selectedMember" IsEditable="_canManageMemberDetails" IsStatusEditable="_canManageMemberStatus" OnMemberUpdated="Reload" />
            @if (_createError != null)
            {
                <p class="text-danger">@_createError</p>
            }
        </CascadingValue>  
    </div>
</div>
