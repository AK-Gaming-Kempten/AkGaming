{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "TournamentApi": {
    "BaseAddress": "https://tournaments.akgaming.de"
  },
  "OpenIdConnect": {
    "Authority": "https://identity.akgaming.de",
    "ClientId": "akgaming-tournaments-frontend",
    "ClientSecret": "change-me",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc",
    "RequireHttpsMetadata": true,
    "Scopes": [
      "openid",
      "profile",
      "email",
      "roles",
      "offline_access",
      "tournaments_api"
    ]
  }
}
