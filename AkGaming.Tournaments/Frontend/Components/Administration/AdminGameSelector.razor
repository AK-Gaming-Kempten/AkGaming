@namespace AkGaming.Tournaments.Frontend.Components.Pages

<div class="game-selector">
    <button type="button" class="game-selector-trigger" @onclick="ToggleGameSelectorAsync" disabled="@IsBusy">
        <LogoImage Type="game" Size="LogoImageSize.Medium" />
        <span class="game-selector-main">
            <span class="game-selector-label">Games</span>
            <strong>@GetSelectedTitle()</strong>
            <span>@GetSelectedSummary()</span>
        </span>
        <span class="game-selector-chevron bi @(IsOpen ? "bi-chevron-up" : "bi-chevron-down")"></span>
    </button>

    @if (IsOpen)
    {
        <button type="button" class="game-selector-dismiss-layer" aria-label="Close game selector" @onclick="CloseGameSelectorAsync"></button>
        <div class="game-selector-menu">
            <div class="game-selector-actions">
                <button type="button" class="solid-button" @onclick="ShowCreateGameForm" disabled="@IsBusy">Create game</button>
            </div>

            @if (isCreateGameFormVisible)
            {
                <AdminGameCreateForm GameId="@newGameId"
                                     GameIdChanged="SetNewGameId"
                                     GameName="@newGameName"
                                     GameNameChanged="SetNewGameName"
                                     IsBusy="@IsBusy"
                                     OnSubmit="CreateGameAsync"
                                     OnCancel="HideCreateGameForm" />
            }

            <div class="game-selector-list">
                <AdminGameOptionList Games="@Games"
                                     SelectedGame="@SelectedGame"
                                     IsBusy="@IsBusy"
                                     OnSelected="SelectGameAsync" />
            </div>
        </div>
    }
</div>
