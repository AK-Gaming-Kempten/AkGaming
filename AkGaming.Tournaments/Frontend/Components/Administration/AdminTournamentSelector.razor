@namespace AkGaming.Tournaments.Frontend.Components.Administration

<div class="game-selector">
    <button type="button" class="game-selector-trigger" @onclick="ToggleTournamentSelectorAsync" disabled="@IsBusy">
        <LogoImage Type="tournament" Size="LogoImageSize.Medium" />
        <span class="game-selector-main">
            <span class="game-selector-label">Tournaments</span>
            <strong>@GetSelectedTitle()</strong>
            <span>@GetSelectedSummary()</span>
        </span>
        <span class="game-selector-chevron bi @(IsOpen ? "bi-chevron-up" : "bi-chevron-down")"></span>
    </button>
    @if (IsOpen)
    {
        <button type="button" class="game-selector-dismiss-layer" aria-label="Close tournament selector" @onclick="CloseTournamentSelectorAsync"></button>
        <div class="game-selector-menu">
            <div class="game-selector-actions">
                <button type="button" class="solid-button" @onclick="ShowCreateTournamentForm" disabled="@IsBusy">Create tournament</button>
            </div>

            @if (isCreateTournamentFormVisible)
            {
                <AdminTournamentCreateForm Games="@Games"
                                           TournamentName="@newTournamentName"
                                           TournamentNameChanged="SetTournamentName"
                                           TournamentSlug="@newTournamentSlug"
                                           TournamentSlugChanged="SetTournamentSlug"
                                           GameId="@newTournamentGameId"
                                           GameIdChanged="SetTournamentGame"
                                           IsVisible="@newTournamentIsVisible"
                                           IsVisibleChanged="SetTournamentVisibility"
                                           IsBusy="@IsBusy"
                                           OnSubmit="CreateTournamentAsync"
                                           OnCancel="HideCreateTournamentForm" />
            }

            <div class="game-selector-list">
                <AdminTournamentOptionList Tournaments="@Tournaments"
                                           SelectedTournament="@SelectedTournament"
                                           IsBusy="@IsBusy"
                                           OnSelected="SelectTournamentAsync" />
            </div>
        </div>
    }
</div>
