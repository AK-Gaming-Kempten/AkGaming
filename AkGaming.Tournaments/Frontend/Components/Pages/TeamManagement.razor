@page "/teams/manage"
@attribute [Authorize]

<PageTitle>Team Management</PageTitle>

<section class="app-page">
    <PageHeader Title="Team management">
        <Actions>
            <a class="ghost-button" href="/player-profiles">Player profiles</a>
            @if (selectedTeam is not null)
            {
                <a class="ghost-button" href="@($"/teams/{selectedTeam.Id}")">Open team</a>
            }
        </Actions>
    </PageHeader>

    <ApiErrorPanel Message="@errorMessage" />

    @if (isLoading)
    {
        <SurfacePanel Title="Loading">
            <p class="muted-copy">Loading team management data.</p>
        </SurfacePanel>
    }
    else
    {
        <div class="content-grid">
            <div class="stack">
                <SurfacePanel Title="Create team" Subtitle="Teams are bound to one game and can later register for tournaments in that game.">
                    <div class="backend-form">
                        <label>
                            <span>Game</span>
                            <GameSelect Games="@games" Value="@teamGameId" ValueChanged="SetTeamGame" />
                        </label>
                        <label>
                            <span>Team name</span>
                            <input class="form-input" @bind="teamName" placeholder="AKG Blue" />
                        </label>
                        <button type="button" class="solid-button" @onclick="CreateTeamAsync" disabled="@isBusy">Create team</button>
                    </div>
                </SurfacePanel>

                <SurfacePanel Title="Load existing team" Subtitle="Use a backend team id to continue working with an existing team.">
                    <div class="backend-form">
                        <label>
                            <span>Team id</span>
                            <input class="form-input" @bind="teamLookupId" placeholder="00000000-0000-0000-0000-000000000000" />
                        </label>
                        <button type="button" class="ghost-button" @onclick="LoadTeamAsync" disabled="@isBusy">Load team</button>
                    </div>
                </SurfacePanel>

                @if (selectedTeam is not null)
                {
                    <SurfacePanel Title="Guest profile" Subtitle="Guest profiles inherit the selected team's game.">
                        <div class="backend-form">
                            <label>
                                <span>Guest name</span>
                                <input class="form-input" @bind="guestProfileName" placeholder="Guest Support" />
                            </label>
                            <button type="button" class="solid-button" @onclick="CreateGuestProfileAsync" disabled="@isBusy">Create guest</button>
                        </div>
                    </SurfacePanel>
                }
            </div>

            <div class="stack">
                @if (selectedTeam is not null)
                {
                    <SurfacePanel Title="Selected team">
                        <BackendTeamCard Team="@selectedTeam" GameName="@GetGameName(selectedTeam.GameId)" />
                    </SurfacePanel>

                    <SurfacePanel Title="Available roster profiles" Subtitle="Only profiles for the team's game are selectable.">
                        <PlayerProfileList Profiles="@availableProfiles"
                                           EmptyState="No available profiles for this team and game yet."
                                           Selectable="true"
                                           SelectedProfileIds="@selectedProfileIds"
                                           OnProfileSelected="SelectProfile"
                                           OnProfileDeselected="DeselectProfile" />
                    </SurfacePanel>

                    <SurfacePanel Title="Submit registration" Subtitle="The backend expects a tournament id until tournament management endpoints exist.">
                        <div class="backend-form">
                            <label>
                                <span>Tournament id</span>
                                <input class="form-input" @bind="tournamentId" placeholder="00000000-0000-0000-0000-000000000000" />
                            </label>
                            <button type="button" class="solid-button" @onclick="SubmitRegistrationAsync" disabled="@isBusy">Submit registration</button>
                        </div>
                    </SurfacePanel>

                    <SurfacePanel Title="Registrations">
                        <RegistrationList Registrations="@registrations" />
                    </SurfacePanel>
                }
                else
                {
                    <SurfacePanel Title="No team selected">
                        <p class="muted-copy">Create a team or load an existing team to manage guests, roster profiles, and registrations.</p>
                    </SurfacePanel>
                }
            </div>
        </div>
    }
</section>
