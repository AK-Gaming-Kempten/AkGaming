@page "/teams/{TeamId:guid}"

<PageTitle>@(team is null ? "Team" : $"{team.Name} Team")</PageTitle>

<section class="app-page">
    <PageHeader Title="Team details" />

    @if (isAuthenticated)
    {
        <MyTeamSelector SelectedTeamId="@TeamId" />
    }

    <ApiErrorPanel Message="@errorMessage" />

    @if (isLoading)
    {
        <SurfacePanel Title="Loading">
            <p class="muted-copy">Loading team from the tournament backend.</p>
        </SurfacePanel>
    }
    else if (team is null)
    {
        <SurfacePanel Title="Team not found">
            <p class="muted-copy">No backend team exists for this id.</p>
        </SurfacePanel>
    }
    else
    {
        <div class="content-grid">
            <div class="stack">
                <SurfacePanel Title="Team">
                    <BackendTeamCard Team="@team" GameName="@GetGameName(team.GameId)" />
                </SurfacePanel>

                <SurfacePanel Title="Guest profiles">
                    <PlayerProfileList Profiles="@team.GuestPlayerProfiles" EmptyState="This team does not have guest profiles." />
                </SurfacePanel>
            </div>

            <div class="stack">
                <SurfacePanel Title="Available roster profiles">
                    <PlayerProfileList Profiles="@availableProfiles" EmptyState="No roster profiles are available for this team's game." />
                </SurfacePanel>

                <SurfacePanel Title="Registrations">
                    <RegistrationList Registrations="@registrations" />
                </SurfacePanel>
            </div>
        </div>
    }
</section>
