@page "/tournaments/{TournamentSlug}/player/team-space"
@attribute [Authorize]
@inherits TournamentPageBase

<PageTitle>@($"{Tournament.Summary.Title} Team Space")</PageTitle>

@{
    var rosterTeam = Tournament.Teams.FirstOrDefault();
    var nextMatch = Tournament.Matches.FirstOrDefault();
}

<section class="app-page">
    <PageHeader Eyebrow="Player"
                Title="Team space"
                Description="Authenticated users get a player-facing workspace for rosters, invites, and match readiness." />

    <div class="content-grid">
        <div class="stack">
            <SurfacePanel Title="Readiness checklist"
                          Subtitle="These placeholders map cleanly to future invite, verification, and consent APIs.">
                <StatusList Items="@Tournament.PlayerTasks" EmptyState="No player tasks currently queued." />
            </SurfacePanel>

            @if (nextMatch is not null)
            {
                <SurfacePanel Title="Next match"
                              Subtitle="Same shared card as public schedule and admin match desk.">
                    <MatchCard Match="@nextMatch" />
                </SurfacePanel>
            }
        </div>

        <div class="stack">
            @if (rosterTeam is not null)
            {
                <SurfacePanel Title="Active roster"
                              Subtitle="Later this becomes the captain-controlled team access area.">
                    <TeamCard Team="@rosterTeam" />
                </SurfacePanel>
            }

            <SurfacePanel Title="What comes next"
                          Subtitle="Backend work is intentionally deferred.">
                <p>
                    Invite acceptance, roster ownership transfer, fair-play consent, and rank verification all belong here eventually.
                    For now the UI shape is stable and data comes from a shared mock catalog.
                </p>
            </SurfacePanel>
        </div>
    </div>
</section>
