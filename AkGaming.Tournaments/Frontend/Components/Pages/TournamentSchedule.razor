@page "/tournaments/{TournamentSlug}/schedule"
@inherits TournamentPageBase

<PageTitle>@($"{Tournament.Summary.Title} Schedule")</PageTitle>

<section class="app-page">
    <PageHeader Eyebrow="Public Schedule"
                Title="@($"{Tournament.Summary.Title} match flow")"
                Description="This page is still public-facing. It focuses on fixtures, operational status, and tournament progression." />

    <div class="content-grid">
        <div class="stack">
            <SurfacePanel Title="Current blocks"
                          Subtitle="@Tournament.NextMilestone">
                <div class="stack">
                    @foreach (var match in Tournament.Matches)
                    {
                        <MatchCard Match="@match" />
                    }
                </div>
            </SurfacePanel>
        </div>

        <div class="stack">
            <SurfacePanel Title="Tournament progression"
                          Subtitle="A backend can later replace these status rows with real stage state.">
                <StatusList Items="@Tournament.Timeline" EmptyState="No stage data yet." />
            </SurfacePanel>

            <SurfacePanel Title="Ops note"
                          Subtitle="The same data also feeds the admin match desk mockup.">
                <p>
                    Schedule data will likely become one of the earliest shared contracts between public pages and staff tooling,
                    so the card shape is intentionally reusable.
                </p>
            </SurfacePanel>
        </div>
    </div>
</section>
