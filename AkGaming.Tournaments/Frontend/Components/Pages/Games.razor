@page "/games"
@inject GamesApiClient GamesClient

<PageTitle>Supported Games</PageTitle>

<section class="app-page">
    <PageHeader Title="Supported games" />

    <ApiErrorPanel Message="@errorMessage" />

    @if (isLoading)
    {
        <SurfacePanel Title="Loading">
            <p class="muted-copy">Loading games from the tournament backend.</p>
        </SurfacePanel>
    }
    else if (games.Count == 0)
    {
        <SurfacePanel Title="No games">
            <p class="muted-copy">The backend did not return any supported games yet.</p>
        </SurfacePanel>
    }
    else
    {
        <div class="game-grid">
            @foreach (var game in games)
            {
                <article class="game-card">
                    <span class="info-chip">
                        <span class="bi bi-controller"></span>
                        @game.Id
                    </span>
                    <h3>@game.Name</h3>
                    <p>Teams and player profiles created for this game stay scoped to this game.</p>
                </article>
            }
        </div>
    }
</section>

@code {
    private IReadOnlyList<GameDto> games = [];
    private string? errorMessage;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            games = await GamesClient.GetGamesAsync();
        }
        catch (TournamentApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
