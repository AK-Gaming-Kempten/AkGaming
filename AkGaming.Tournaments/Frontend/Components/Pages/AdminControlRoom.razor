@page "/tournaments/{TournamentSlug}/administration/control-room"
@attribute [Authorize(Roles = "Admin")]
@inherits TournamentPageBase

<PageTitle>@($"{Tournament.Summary.Title} Control Room")</PageTitle>

<section class="app-page">
    <PageHeader Title="Control room" />

    <div class="stats-grid">
        @foreach (var metric in Tournament.Metrics.Take(3))
        {
            <MetricCard Label="@metric.Label" Value="@metric.Value" Caption="@metric.Caption" />
        }
    </div>

    <div class="content-grid">
        <div class="stack">
            <SurfacePanel Title="Queue">
                <StatusList Items="@Tournament.AdminQueue" EmptyState="No queued admin work." />
            </SurfacePanel>
        </div>

        <div class="stack">
            <SurfacePanel Title="Updates">
                <StatusList Items="@Tournament.Updates" EmptyState="No updates yet." />
            </SurfacePanel>
        </div>
    </div>
</section>
