<article class="backend-team-card">
    <div class="backend-team-card-header">
        <div>
            <h3>@Team.Name</h3>
            <p>@GameName</p>
        </div>
        <a class="ghost-button" href="@($"/teams/{Team.Id}")">Open</a>
    </div>

    <div class="backend-team-card-meta">
        <span class="info-chip">
            <span class="bi bi-people-fill"></span>
            @Team.Memberships.Count members
        </span>
        <span class="info-chip">
            <span class="bi bi-person-badge-fill"></span>
            @Team.GuestPlayerProfiles.Count guests
        </span>
    </div>

    <ul class="backend-team-members">
        @foreach (var membership in Team.Memberships)
        {
            <li>
                <span>@membership.UserId</span>
                <span class="status-pill status-pill-neutral">@membership.Role</span>
            </li>
        }
    </ul>
</article>

@code {
    [Parameter] public TeamDto Team { get; set; } = default!;
    [Parameter] public string GameName { get; set; } = string.Empty;
}
