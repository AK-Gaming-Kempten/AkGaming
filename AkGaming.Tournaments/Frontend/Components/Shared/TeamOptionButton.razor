<button type="button"
        class="team-option @(Selected ? "team-option-selected" : null)"
        @onclick="SelectAsync"
        disabled="@Disabled">
    <span class="team-avatar">@GetTeamInitials()</span>
    <span class="team-option-main">
        <strong>@Team.Name</strong>
        <span>@RoleLabel · @GameName</span>
    </span>
    <span class="team-game-badge">@GetGameInitials()</span>
</button>
