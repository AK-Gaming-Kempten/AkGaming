<div class="unauthorized-wrapper">
    @if (!string.IsNullOrWhiteSpace(ImageUrl))
    {
        <img class="unauthorized-image" src="@ImageUrl" alt="Not Authorized" />
    }

    <div class="unauthorized-content">
        @ChildContent
    </div>

    <button class="unauthorized-button" @onclick="Login">
        Login
    </button>
</div>
