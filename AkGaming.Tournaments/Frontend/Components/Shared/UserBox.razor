@namespace AkGaming.Tournaments.Frontend.Components.Shared

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized>
            <div class="user-box">
                <div class="user-info">
                    <div class="user-label">Logged in as</div>
                    <div class="user-name" title="@DisplayName">@DisplayName</div>
                </div>
                <button class="btn btn-primary" @onclick="Logout">Logout</button>
            </div>
        </Authorized>

        <NotAuthorized>
            <div class="user-box">
                <div class="user-info">
                    <div class="user-label">Not logged in</div>
                    <div class="user-name">Public browsing only</div>
                </div>
                <button class="btn btn-primary" @onclick="Login">Login</button>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>
