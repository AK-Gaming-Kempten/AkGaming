<div class="sidebar">
    <div class="sidebar-header">
        <img src="images/icons/AKG_Logos/Default.png" alt="AKGaming Logo" class="sidebar-logo">
        <span class="sidebar-title">Tournament Hub</span>
    </div>

    <div class="sidebar-content">
        <nav class="sidebar-nav">
            <div class="nav-section">
                <div class="nav-section-title">
                    <span class="nav-icon bi-compass-fill"></span>
                    General
                </div>
                <NavLink href="" Match="NavLinkMatch.All" class="nav-item level-1" @onclick="NotifyNavigation">
                    <span class="nav-icon bi-house-door-fill"></span>
                    <span>Landing</span>
                </NavLink>
                <NavLink href="discover" class="nav-item level-1" @onclick="NotifyNavigation">
                    <span class="nav-icon bi-search-heart-fill"></span>
                    <span>Discover</span>
                </NavLink>
                <NavLink href="player-profiles" class="nav-item level-1" @onclick="NotifyNavigation">
                    <span class="nav-icon bi-person-badge-fill"></span>
                    <span>Player Profiles</span>
                </NavLink>
                <NavLink href="teams/manage" class="nav-item level-1" @onclick="NotifyNavigation">
                    <span class="nav-icon bi-flag-fill"></span>
                    <span>My Teams</span>
                </NavLink>
            </div>

            @if (isAuthenticated && isAdmin)
            {
                <div class="nav-section">
                    <div class="nav-section-title">
                        <span class="nav-icon bi-shield-lock-fill"></span>
                        Administration
                    </div>
                    <NavLink href="administration/games" class="nav-item level-1" @onclick="NotifyNavigation">
                        <span class="nav-icon bi-controller"></span>
                        <span>Games</span>
                    </NavLink>
                    <NavLink href="administration/tournaments" class="nav-item level-1" @onclick="NotifyNavigation">
                        <span class="nav-icon bi-trophy-fill"></span>
                        <span>Tournaments</span>
                    </NavLink>
                </div>
            }

            <TournamentContextPanel Show="@ShowTournamentContext"
                                    CanChangeTournament="@CanChangeTournament"
                                    IsAdmin="@isAdmin"
                                    CurrentTournamentName="@CurrentTournamentName"
                                    CurrentTournamentSubline="@CurrentTournamentSubline"
                                    SelectedTournamentSlug="@selectedTournamentSlug"
                                    Tournaments="@tournaments"
                                    TournamentChanged="HandleTournamentChanged" />

            <TournamentNavSections HasSelectedTournament="@HasSelectedTournament"
                                   IsAuthenticated="@isAuthenticated"
                                   IsAdmin="@isAdmin"
                                   IsPublicExpanded="@isPublicExpanded"
                                   IsPlayerExpanded="@isPlayerExpanded"
                                   IsAdministrationExpanded="@isAdministrationExpanded"
                                   SelectedTournamentSlug="@selectedTournamentSlug"
                                   TogglePublicExpanded="TogglePublicExpanded"
                                   TogglePlayerExpanded="TogglePlayerExpanded"
                                   ToggleAdministrationExpanded="ToggleAdministrationExpanded"
                                   NotifyNavigation="NotifyNavigation" />
        </nav>
    </div>

    <div class="sidebar-footer">
        <ThemeSwitcherBox />
        <UserBox />
    </div>
</div>
