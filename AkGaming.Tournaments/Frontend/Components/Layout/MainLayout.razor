@inherits LayoutComponentBase

<div class="page">
    <header class="mobile-header">
        <button type="button"
                class="mobile-menu-toggle"
                aria-label="Toggle navigation menu"
                aria-expanded="@_isMobileNavOpen"
                @onclick="ToggleMobileNav">
            <span class="bi bi-list"></span>
        </button>
        <div class="mobile-header-brand">
            <img src="images/icons/AKG_Logos/Default.png" alt="AKGaming Logo" class="mobile-header-logo" />
            <span>Tournament Hub</span>
        </div>
    </header>

    <div class="layout-shell">
        <aside class="sidebar-drawer @(_isMobileNavOpen ? "is-open" : string.Empty)">
            <NavMenu OnNavigate="CloseMobileNav" />
        </aside>

        @if (_isMobileNavOpen)
        {
            <button type="button" class="sidebar-backdrop" aria-label="Close navigation menu" @onclick="CloseMobileNav"></button>
        }

        <main @onclick="CloseMobileNavIfOpen">
            <article class="content @(IsHomeRoute ? "content-fullbleed" : string.Empty)">
                @Body
            </article>
        </main>
    </div>
</div>

<ReconnectOverlay AppName="AK Gaming Tournaments"
                  LogoUrl="images/icons/AKG_Logos/Default.png"
                  ShowMessage="Trying to restore your live session and reconnect to the tournament server." />
<BlazorErrorDisplay AppName="AK Gaming Tournaments" />
