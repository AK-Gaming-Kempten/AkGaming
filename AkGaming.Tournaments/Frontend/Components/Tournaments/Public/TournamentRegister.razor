@page "/tournaments/{TournamentSlug}/register"
@namespace AkGaming.Tournaments.Frontend.Components.Pages
@inherits TournamentPageBase

<PageTitle>@($"{Tournament.Summary.Title} Registration")</PageTitle>

<section class="app-page">
    <TournamentPublicTabs TournamentSlug="@Tournament.Summary.Slug" ActiveSection="register" />
    <PageHeader Title="Register team"
                Description="@($"Submit a team registration for {Tournament.Summary.Title}.")" />

    <SurfacePanel Title="Registration" Subtitle="@Tournament.Summary.RegistrationWindow">
        <div class="registration-callout">
            <img src="@Tournament.LogoUrl" alt="@($"{Tournament.Summary.Title} logo")" />
            <div>
                <h3>@Tournament.Summary.Title</h3>
                <p>@Tournament.Summary.Description</p>
                <a class="solid-button" href="/teams/manage">Choose or create team</a>
            </div>
        </div>
    </SurfacePanel>
</section>
