@page "/tournaments/{TournamentSlug}/schedule"
@namespace AkGaming.Tournaments.Frontend.Components.Tournaments.Public
@inherits TournamentPageBase

<PageTitle>@($"{Tournament.Summary.Title} Schedule")</PageTitle>

<section class="app-page">
    <TournamentPublicTabs TournamentSlug="@Tournament.Summary.Slug"
                          ActiveSection="schedule"
                          OnRegisterRequested="ShowRegistrationDialogAsync" />
    <PageHeader Title="Schedule" />

    <SurfacePanel Title="Schedule">
        <p class="muted-copy">TBA</p>
    </SurfacePanel>

    <TournamentRegistrationDialog Tournament="@Tournament"
                                  IsOpen="@IsRegistrationDialogOpen"
                                  IsOpenChanged="SetRegistrationDialogOpenAsync" />
</section>
