@page "/tournaments/{TournamentSlug}"
@namespace AkGaming.Tournaments.Frontend.Components.Tournaments.Public
@inherits TournamentPageBase

<PageTitle>@($"{Tournament?.Name ?? "Tournament"} Overview")</PageTitle>

<section class="app-page">
    <ApiErrorPanel Message="@PublicPageErrorMessage" />

    @if (Tournament is null)
    {
        <TournamentPublicTabs TournamentSlug="@TournamentSlug"
                              ActiveSection="overview"
                              OnRegisterRequested="ShowRegistrationDialogAsync" />

        <SurfacePanel Title="Tournament not found">
            <p>Pick another tournament from the selector to continue.</p>
        </SurfacePanel>
    }
    else
    {
        <TournamentPublicTabs TournamentSlug="@Tournament.Slug"
                              ActiveSection="overview"
                              OnRegisterRequested="ShowRegistrationDialogAsync" />

        <section class="tournament-hero">
            <div class="tournament-banner" style="@GetBannerStyle(Tournament)" aria-label="@($"{Tournament.Name} tournament banner")">
                <div class="tournament-banner-copy">
                    <span class="eyebrow">@Tournament.GameName</span>
                    <h1>@Tournament.Name</h1>
                </div>
            </div>

            <div class="tournament-hero-copy">
                <div class="tournament-logo">
                    <LogoImage LogoAssetId="@Tournament.LogoAssetId"
                               Type="tournament"
                               Alt="@($"{Tournament.Name} logo")"
                               Size="LogoImageSize.Large" />
                </div>
            </div>

            <button type="button" class="solid-button tournament-register-button" @onclick="ShowRegistrationDialogAsync">
                Register team
            </button>
        </section>

        <div class="content-grid">
            <SurfacePanel Title="Tournament info">
                <TournamentInfoFieldGrid Sections="@Tournament.InfoSections" />
            </SurfacePanel>

            <SurfacePanel Title="Timeline" Subtitle="Key dates for registration and play.">
                <TournamentTimeline Items="@TimelineItems" />
            </SurfacePanel>
        </div>

        <TournamentRegistrationDialog Tournament="@Tournament"
                                      IsOpen="@IsRegistrationDialogOpen"
                                      IsOpenChanged="SetRegistrationDialogOpenAsync"
                                      RegistrationSubmitted="HandleRegistrationSubmittedAsync" />
    }
</section>
