@page "/tournaments/{TournamentSlug}"
@namespace AkGaming.Tournaments.Frontend.Components.Tournaments.Public
@inherits TournamentPageBase

<PageTitle>@($"{Tournament.Summary.Title} Overview")</PageTitle>

<section class="app-page">
    <TournamentPublicTabs TournamentSlug="@Tournament.Summary.Slug"
                          ActiveSection="overview"
                          OnRegisterRequested="ShowRegistrationDialogAsync" />

    @if (RequestedTournamentWasMissing)
    {
        <SurfacePanel Title="Tournament not found">
            <p>Pick another tournament from the selector to continue.</p>
        </SurfacePanel>
    }

    <section class="tournament-hero">
        <div class="tournament-banner" aria-label="@($"{Tournament.Summary.Title} tournament banner")">
            <img src="@Tournament.LogoUrl" alt="" aria-hidden="true" />
        </div>

        <div class="tournament-hero-copy">
            <img class="tournament-logo" src="@Tournament.LogoUrl" alt="@($"{Tournament.Summary.Title} logo")" />
            <div>
                <span class="eyebrow">@Tournament.Summary.Season · @Tournament.Summary.Status</span>
                <h1>@Tournament.Summary.Title</h1>
                <p>@Tournament.HeroDescription</p>
            </div>
        </div>

        <button type="button" class="solid-button tournament-register-button" @onclick="ShowRegistrationDialogAsync">
            Register team
        </button>
    </section>

    <div class="content-grid">
        <SurfacePanel Title="Tournament info" Subtitle="@Tournament.Tagline">
            <TournamentInfoFieldGrid Fields="@Tournament.InfoFields" />
        </SurfacePanel>

        <SurfacePanel Title="Timeline" Subtitle="Key dates for registration, check-in, and play.">
            <TournamentTimeline Items="@Tournament.KeyDates" />
        </SurfacePanel>
    </div>

    <TournamentRegistrationDialog Tournament="@Tournament"
                                  IsOpen="@IsRegistrationDialogOpen"
                                  IsOpenChanged="SetRegistrationDialogOpenAsync"
                                  RegistrationSubmitted="HandleRegistrationSubmittedAsync" />
</section>
