@page "/tournaments/{TournamentSlug}/teams"
@namespace AkGaming.Tournaments.Frontend.Components.Pages
@inherits TournamentPageBase

<PageTitle>@($"{Tournament.Summary.Title} Teams")</PageTitle>

<section class="app-page">
    <TournamentPublicTabs TournamentSlug="@Tournament.Summary.Slug" ActiveSection="teams" />
    <PageHeader Title="Teams" />

    <div class="teams-grid">
        @foreach (var team in Tournament.Teams)
        {
            <TeamCard Team="@team" />
        }
    </div>
</section>
