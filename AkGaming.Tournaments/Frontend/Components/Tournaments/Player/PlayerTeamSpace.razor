@page "/tournaments/{TournamentSlug}/player/team-space"
@namespace AkGaming.Tournaments.Frontend.Components.Tournaments.Player
@attribute [Authorize]
@inherits TournamentPageBase

<PageTitle>@($"{Tournament.Summary.Title} Team Space")</PageTitle>

@{
    var rosterTeam = Tournament.Teams.FirstOrDefault();
    var nextMatch = Tournament.Matches.FirstOrDefault();
}

<section class="app-page">
    <PageHeader Title="Team space" />

    <div class="content-grid">
        <div class="stack">
            <SurfacePanel Title="Tasks">
                <StatusList Items="@Tournament.PlayerTasks" EmptyState="No player tasks currently queued." />
            </SurfacePanel>

            @if (nextMatch is not null)
            {
                <SurfacePanel Title="Next match">
                    <MatchCard Match="@nextMatch" />
                </SurfacePanel>
            }
        </div>

        <div class="stack">
            @if (rosterTeam is not null)
            {
                <SurfacePanel Title="Roster">
                    <TeamCard Team="@rosterTeam" />
                </SurfacePanel>
            }
        </div>
    </div>
</section>
