@namespace AkGaming.Tournaments.Frontend.Components.Tournaments.Components

<article class="tournament-card">
    <div class="tournament-card-top">
        <span class="status-pill @(StatusClass)">
            <span class="bi bi-stars"></span>
            @StatusLabel
        </span>
        <span class="info-chip">
            <span class="bi bi-controller"></span>
            @Summary.GameName
        </span>
    </div>

    <div class="tournament-card-copy">
        <LogoImage LogoAssetId="@Summary.LogoAssetId" Type="tournament" Alt="@($"{Summary.Name} logo")" Size="LogoImageSize.Large" />
        <h3>@Summary.Name</h3>
        <p class="tournament-card-season">@Summary.GameName</p>
    </div>

    <div class="tournament-card-meta">
        <span><span class="bi bi-calendar-event-fill"></span> @DateLabel</span>
        <span><span class="bi bi-people-fill"></span> @Summary.RegisteredTeamCount registered</span>
    </div>

    <div class="tournament-card-footer">
        <a class="solid-button" href="@($"/tournaments/{Summary.Slug}")">Open tournament</a>
    </div>
</article>
