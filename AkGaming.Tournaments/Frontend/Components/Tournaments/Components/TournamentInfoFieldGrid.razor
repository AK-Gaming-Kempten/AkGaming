@namespace AkGaming.Tournaments.Frontend.Components.Tournaments.Components

@if (Sections.Count == 0)
{
    <p class="muted-copy">No tournament information has been published yet.</p>
}
else
{
    <div class="tournament-info-grid">
        @foreach (var infoSection in Sections)
        {
            <article class="tournament-info-field">
                <h3>@infoSection.Header</h3>
                <MarkdownContent Markdown="@infoSection.ContentMarkdown" />
            </article>
        }
    </div>
}
