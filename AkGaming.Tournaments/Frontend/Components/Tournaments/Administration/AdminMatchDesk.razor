@page "/tournaments/{TournamentSlug}/administration/match-desk"
@namespace AkGaming.Tournaments.Frontend.Components.Tournaments.Administration
@attribute [Authorize(Roles = "Admin")]
@inherits TournamentPageBase

<PageTitle>@($"{Tournament.Summary.Title} Match Desk")</PageTitle>

<section class="app-page">
    <PageHeader Title="Match desk" />

    <div class="content-grid">
        <div class="stack">
            <SurfacePanel Title="Matches">
                <div class="stack">
                    @foreach (var match in Tournament.Matches)
                    {
                        <MatchCard Match="@match" />
                    }
                </div>
            </SurfacePanel>
        </div>

        <div class="stack">
            <SurfacePanel Title="Handoff">
                <StatusList Items="@Tournament.AdminQueue" EmptyState="No handoff tasks." />
            </SurfacePanel>
        </div>
    </div>
</section>
