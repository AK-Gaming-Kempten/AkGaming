@page "/tournaments/{TournamentSlug}/administration/base-settings"
@page "/tournaments/{TournamentSlug}/administration/control-room"
@namespace AkGaming.Tournaments.Frontend.Components.Tournaments.Administration
@attribute [Authorize(Roles = "Admin")]
@inherits TournamentPageBase

<PageTitle>@($"{Tournament?.Name ?? "Tournament"} Base Settings")</PageTitle>

<section class="app-page">
    <PageHeader Title="Base Settings" />

    @if (Tournament is null)
    {
        <SurfacePanel Title="Tournament not found">
            <p>Pick another tournament from the selector to continue.</p>
        </SurfacePanel>
    }
    else
    {
        <div class="stack">
            <TournamentContentEditor Tournament="@Tournament"
                                     IsBusy="@isBusy"
                                     ErrorMessage="@errorMessage"
                                     SuccessMessage="@successMessage"
                                     IdentitySaveRequested="HandleIdentitySaveRequestedAsync"
                                     TimelineSaveRequested="HandleTimelineSaveRequestedAsync"
                                     InfoSectionsSaveRequested="HandleInfoSectionsSaveRequestedAsync"
                                     RegistrationRulesSaveRequested="HandleRegistrationRulesSaveRequestedAsync"
                                     LogoUploaded="HandleLogoUploadedAsync"
                                     BannerUploaded="HandleBannerUploadedAsync"
                                     ClearBannerRequested="HandleClearBannerRequestedAsync"
                                     ClearLogoRequested="HandleClearLogoRequestedAsync" />
        </div>
    }
</section>
