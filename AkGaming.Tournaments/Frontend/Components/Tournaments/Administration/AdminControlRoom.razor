@page "/tournaments/{TournamentSlug}/administration/control-room"
@namespace AkGaming.Tournaments.Frontend.Components.Tournaments.Administration
@attribute [Authorize(Roles = "Admin")]
@inherits TournamentPageBase

<PageTitle>@($"{Tournament?.Name ?? "Tournament"} Control Room")</PageTitle>

<section class="app-page">
    <PageHeader Title="Control room" />

    @if (Tournament is null)
    {
        <SurfacePanel Title="Tournament not found">
            <p>Pick another tournament from the selector to continue.</p>
        </SurfacePanel>
    }
    else
    {
        <TournamentContentEditor Tournament="@Tournament"
                                 IsBusy="@isBusy"
                                 ErrorMessage="@errorMessage"
                                 SaveRequested="HandleSaveRequestedAsync" />
    }
</section>
