@page "/teams/{TeamId:guid}"
@namespace AkGaming.Tournaments.Frontend.Components.Pages

<PageTitle>@(team is null ? "Team" : $"{team.Name} Team")</PageTitle>

<section class="app-page">
    <PageHeader Title="Team details" />

    @if (isAuthenticated)
    {
        <MyTeamSelector SelectedTeamId="@TeamId" />
    }

    <ApiErrorPanel Message="@errorMessage" />

    @if (isLoading)
    {
        <SurfacePanel Title="Loading">
            <p class="muted-copy">Loading team from the tournament backend.</p>
        </SurfacePanel>
    }
    else if (team is null)
    {
        <SurfacePanel Title="Team not found">
            <p class="muted-copy">No backend team exists for this id.</p>
        </SurfacePanel>
    }
    else
    {
        <TeamDetailsView Team="@team"
                         GameName="@GetGameName(team.GameId)"
                         AvailableProfiles="@availableProfiles"
                         Registrations="@registrations"
                         IsAuthenticated="@isAuthenticated"
                         IsBusy="@isBusy"
                         OnLogoUploaded="SetTeamLogoAsync"
                         OnLogoCleared="ClearTeamLogoAsync" />
    }
</section>
