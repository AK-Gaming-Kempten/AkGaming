@namespace AkGaming.Tournaments.Frontend.Components.Teams.Components

@if (Teams.Count == 0)
{
    <p class="empty-copy">@EmptyState</p>
}
else
{
    @foreach (var team in Teams)
    {
        <TeamOptionButton Team="@team"
                          GameName="@GetGameName(team.GameId)"
                          RoleLabel="@GetUserRoleLabel(team)"
                          Selected="@(SelectedTeamId == team.Id)"
                          Disabled="@Disabled"
                          OnSelected="OnSelected" />
    }
}