@namespace AkGaming.Tournaments.Frontend.Components.Shared

@if (Profiles.Count == 0)
{
    <p class="empty-copy">@EmptyState</p>
}
else
{
    @if (openMenuProfileId is not null)
    {
        <button type="button" class="row-menu-backdrop" @onclick="CloseMenuAsync" aria-label="Close profile actions"></button>
    }

    <div class="team-roster-list">
        @foreach (var profile in Profiles)
        {
            <article class="team-roster-row @(profile.Type == PlayerProfileTypeDto.Guest ? "is-guest" : "is-member")">
                <LogoImage LogoAssetId="@profile.LogoAssetId" Type="player" Alt="@($"{profile.Name} logo")" Size="LogoImageSize.Small" />
                <span class="team-roster-main">
                    <strong>@profile.Name</strong>
                    <span>@FormatProfileMeta(profile)</span>
                </span>
                <span class="status-pill @(profile.Type == PlayerProfileTypeDto.Guest ? "status-pill-neutral" : "status-pill-positive")">
                    @(profile.Type == PlayerProfileTypeDto.Guest ? "Guest" : "Member")
                </span>
                @if (CanEdit)
                {
                    <div class="row-menu">
                        <button type="button"
                                class="row-menu-trigger"
                                aria-label="@($"Open actions for {profile.Name}")"
                                @onclick="() => ToggleMenuAsync(profile.Id)">
                            <span class="bi bi-three-dots-vertical"></span>
                        </button>
                        @if (openMenuProfileId == profile.Id)
                        {
                            <div class="row-menu-popover">
                            @if (profile.Type == PlayerProfileTypeDto.Guest)
                            {
                                <button type="button" @onclick="() => RequestEditAsync(profile)" disabled="@IsBusy">Edit</button>
                                <button type="button" class="danger-action" @onclick="() => RequestDeleteAsync(profile)" disabled="@IsBusy">Remove</button>
                            }
                            else
                            {
                                <span>Member profile</span>
                            }
                            </div>
                        }
                    </div>
                }
            </article>
        }
    </div>
}
