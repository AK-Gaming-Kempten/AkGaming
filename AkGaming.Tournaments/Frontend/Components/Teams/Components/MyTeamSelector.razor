@namespace AkGaming.Tournaments.Frontend.Components.Teams.Components

@if (isLoading)
{
    <SurfacePanel Title="My teams">
        <p class="muted-copy">Loading your teams.</p>
    </SurfacePanel>
}
else if (!isAuthenticated)
{
    @if (ShowLoginSuggestion)
    {
        <UnauthorizedPanel ImageUrl="images/icons/AKG_Logos/Red.png">
            <p>Login to select and manage your teams.</p>
        </UnauthorizedPanel>
    }
}
else
{
    <div class="team-selector">
        <button type="button" class="team-selector-trigger" @onclick="ToggleTeamPicker" disabled="@isBusy">
            <LogoImage Type="team" Size="LogoImageSize.Medium" />
            <span class="team-selector-main">
                <span class="team-selector-label">My Teams</span>
                <strong>Select team</strong>
                <span>Choose one of your teams or create a new one.</span>
            </span>
            <span class="team-selector-chevron bi @(isTeamPickerOpen ? "bi-chevron-up" : "bi-chevron-down")"></span>
        </button>

        @if (isTeamPickerOpen)
        {
            <button type="button" class="team-selector-dismiss-layer" aria-label="Close team selector" @onclick="CloseTeamPicker"></button>
            <div class="team-selector-menu">
                <div class="team-selector-actions">
                    <button type="button" class="solid-button" @onclick="ShowCreateTeamForm" disabled="@isBusy">Create team</button>
                </div>

                @if (isCreateTeamFormVisible)
                {
                    <TeamCreateForm Games="@games"
                                    GameId="@teamGameId"
                                    GameIdChanged="SetTeamGame"
                                    TeamName="@teamName"
                                    TeamNameChanged="SetTeamName"
                                    IsBusy="@isBusy"
                                    OnSubmit="CreateTeamAsync"
                                    OnCancel="HideCreateTeamForm" />
                }

                <div class="team-selector-list">
                    <TeamOptionList Teams="@userTeams"
                                    Games="@games"
                                    SelectedTeamId="@selectedTeam?.Id"
                                    CurrentUserId="@currentUserId"
                                    Disabled="@isBusy"
                                    OnSelected="SelectTeamAsync" />
                </div>
            </div>
        }
    </div>

    <ApiErrorPanel Message="@errorMessage" />
}
