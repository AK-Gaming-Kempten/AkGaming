@namespace AkGaming.Tournaments.Frontend.Components.Teams.Components

<div class="stack">
    <TeamHeaderBanner Team="@Team"
                      GameName="@GameName"
                      CanEdit="@CanEditTeam"
                      IsBusy="@IsBusy"
                      EditRequested="OnTeamEditRequested"
                      InviteManagementRequested="OnInviteManagementRequested" />

    @if (IsTeamEditMode)
    {
        <SurfacePanel Title="Edit team">
            <div class="team-edit-form">
                <label>
                    <span>Team name</span>
                    <input class="form-input" value="@TeamName" @oninput="HandleTeamNameChanged" placeholder="Team name" disabled="@IsBusy" />
                </label>
                <label>
                    <span>Primary color</span>
                    <input class="form-input" value="@TeamPrimaryColor" @oninput="HandleTeamPrimaryColorChanged" placeholder="#0f3f2a" disabled="@IsBusy" />
                </label>
                <label>
                    <span>Team link</span>
                    <input class="form-input" value="@TeamProfileLink" @oninput="HandleTeamProfileLinkChanged" placeholder="OP.GG, Steam Profile,..." disabled="@IsBusy" />
                </label>
                <div class="logo-actions">
                    <LogoUploadDialog Uploaded="OnLogoUploaded" />
                    <button type="button" class="ghost-button" @onclick="OnLogoCleared" disabled="@IsBusy">Clear logo</button>
                    <LogoUploadDialog ButtonLabel="Upload banner" Uploaded="OnBannerUploaded" />
                    <button type="button" class="ghost-button" @onclick="OnBannerCleared" disabled="@IsBusy">Clear banner</button>
                </div>
                <div class="team-edit-actions">
                    <button type="button" class="solid-button" @onclick="OnTeamSubmitted" disabled="@(IsBusy || string.IsNullOrWhiteSpace(TeamName))">Save team</button>
                    <button type="button" class="ghost-button" @onclick="OnTeamEditCanceled" disabled="@IsBusy">Cancel</button>
                </div>
            </div>
        </SurfacePanel>
    }

    <div class="content-grid">
        <div class="stack">
        <SurfacePanel Title="Roster profiles" Subtitle="User and guest player profiles available for tournament registration.">
            @if (CanEditTeam)
            {
                <div class="roster-toolbar">
                    <button type="button" class="solid-button" @onclick="OnGuestCreateRequested" disabled="@IsBusy">Add guest profile</button>
                </div>
            }

            @if (CanEditTeam && IsGuestFormVisible)
            {
                <div class="guest-profile-form">
                    <label>
                        <span>Guest name</span>
                        <input class="form-input" value="@GuestName" @oninput="HandleGuestNameChanged" placeholder="Guest player" disabled="@IsBusy" />
                    </label>
                    <label>
                        <span>MMR</span>
                        <PlayerRankSelect GameId="@Team.GameId" Value="@GuestRankRating" ValueChanged="GuestRankRatingChanged" Disabled="@IsBusy" />
                    </label>
                    <label>
                        <span>Profile link</span>
                        <input class="form-input" value="@GuestProfileLink" @oninput="HandleGuestProfileLinkChanged" placeholder="OP.GG, Steam Profile,..." disabled="@IsBusy" />
                    </label>
                    <div class="guest-profile-actions">
                        <button type="button" class="solid-button" @onclick="OnGuestSubmitted" disabled="@(IsBusy || string.IsNullOrWhiteSpace(GuestName))">@GuestSubmitLabel</button>
                        <button type="button" class="ghost-button" @onclick="OnGuestEditCanceled" disabled="@IsBusy">Cancel</button>
                    </div>
                </div>
            }

            <TeamRosterList Profiles="@AvailableProfiles"
                            CanEdit="@CanEditTeam"
                            IsBusy="@IsBusy"
                            EditGuestRequested="OnGuestEditRequested"
                            DeleteGuestRequested="OnGuestDeleteRequested"
                            EmptyState="No roster profiles are available for this team's game." />
        </SurfacePanel>
        </div>

        <div class="stack">
            <SurfacePanel Title="Members" Subtitle="Users who can contribute player profiles to this team's roster.">
                @if (CanEditTeam)
                {
                    <div class="team-members-toolbar">
                        <button type="button" class="solid-button" @onclick="OnInviteManagementRequested" disabled="@IsBusy">Invite</button>
                    </div>
                }
                <div class="team-member-list">
                    @foreach (var member in Team.Memberships)
                    {
                        <TeamMemberListItem Member="@member"
                                            DisplayName="@GetMemberDisplayName(member)"
                                            Initial="@GetMemberInitial(member)"
                                            CanManageRoles="@CanManageRoles"
                                            IsBusy="@IsBusy"
                                            PromoteToEditorRequested="OnPromoteToEditorRequested"
                                            DemoteToMemberRequested="OnDemoteToMemberRequested"
                                            TransferOwnershipRequested="OnTransferOwnershipRequested" />
                    }
                </div>
            </SurfacePanel>

            <SurfacePanel Title="Registrations">
                <RegistrationList Registrations="@Registrations"
                                  TournamentNames="@TournamentNames" />
            </SurfacePanel>
        </div>
    </div>
</div>
