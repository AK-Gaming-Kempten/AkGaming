@namespace AkGaming.Tournaments.Frontend.Components.Teams.Components

@if (string.IsNullOrWhiteSpace(Href))
{
    <button type="button"
            class="team-option @(Selected ? "team-option-selected" : null)"
            @onclick="SelectAsync"
            disabled="@Disabled">
        <LogoImage LogoAssetId="@Team.LogoAssetId" Type="team" Alt="@($"{Team.Name} logo")" Size="LogoImageSize.Medium" />
        <span class="team-option-main">
            <strong>@Team.Name</strong>
            <span>@RoleLabel · @GameName</span>
        </span>
        <span class="team-game-badge"><span class="bi bi-controller"></span></span>
    </button>
}
else
{
    <a class="team-option @(Selected ? "team-option-selected" : null)"
       href="@Href"
       aria-label="@($"Open team {Team.Name}")">
        <LogoImage LogoAssetId="@Team.LogoAssetId" Type="team" Alt="@($"{Team.Name} logo")" Size="LogoImageSize.Medium" />
        <span class="team-option-main">
            <strong>@Team.Name</strong>
            <span>@RoleLabel · @GameName</span>
        </span>
        <span class="team-game-badge"><span class="bi bi-controller"></span></span>
    </a>
}
