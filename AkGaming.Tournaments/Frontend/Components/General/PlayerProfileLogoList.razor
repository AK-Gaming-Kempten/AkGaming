@namespace AkGaming.Tournaments.Frontend.Components.Shared

@if (Profiles.Count > 0)
{
    <SurfacePanel Title="Profile logos">
        <div class="profile-logo-list">
            @foreach (var profile in Profiles)
            {
                <PlayerProfileLogoRow Profile="@profile"
                                      IsBusy="@IsBusy"
                                      LogoUploaded="LogoUploaded"
                                      LogoCleared="LogoCleared" />
            }
        </div>
    </SurfacePanel>
}
