@page "/"
@namespace AkGaming.Tournaments.Frontend.Components.General

<PageTitle>Tournament Hub</PageTitle>

<section class="hero-section">
    <div class="hero-copy">
        <span class="eyebrow">AK Gaming Tournaments</span>
        <h1 class="hero-title">Welcome to Kemptens Home for E-Sports.</h1>
        <div class="hero-actions">
            <a href="/discover" class="solid-button">All tournaments</a>
            @if (FeaturedTournament is not null)
            {
                <a href="@($"/tournaments/{FeaturedTournament.Slug}")" class="ghost-button">Featured tournament</a>
            }
        </div>
    </div>
</section>

<section class="app-page home-content">
    <PageHeader Title="Tournaments" />
    <ApiErrorPanel Message="@errorMessage" />

    @if (isLoading)
    {
        <p class="muted-copy">Loading tournaments.</p>
    }
    else
    {
        <div class="home-tournament-grid">
            @foreach (var tournament in tournaments)
            {
                <TournamentCard Summary="@tournament" />
            }
        </div>
    }
</section>
