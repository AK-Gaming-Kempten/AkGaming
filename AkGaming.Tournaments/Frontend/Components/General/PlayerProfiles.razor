@page "/player-profiles"
@namespace AkGaming.Tournaments.Frontend.Components.General
@attribute [Authorize]

<PageTitle>Player Profiles</PageTitle>

<section class="app-page">
    <PageHeader Title="Player profiles" />

    <ApiErrorPanel Message="@errorMessage" />

    @if (isLoading)
    {
        <SurfacePanel Title="Loading">
            <p class="muted-copy">Loading your game-specific player profiles.</p>
        </SurfacePanel>
    }
    else
    {
        <SurfacePanel Title="Your profiles">
            <div class="profiles-toolbar">
                <button type="button" class="solid-button" @onclick="StartCreateProfileAsync">Create profile</button>
            </div>
            <PlayerProfileOptionList Profiles="@playerProfiles"
                                     Games="@games"
                                     EmptyState="Create a game-specific player profile to use it in team rosters."
                                     OnSelected="OpenProfileAsync" />
        </SurfacePanel>
    }
</section>
