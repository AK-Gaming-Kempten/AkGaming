@page "/player-profiles"
@namespace AkGaming.Tournaments.Frontend.Components.Pages
@attribute [Authorize]

<PageTitle>Player Profiles</PageTitle>

<section class="app-page">
    <PageHeader Title="Player profiles" />

    <ApiErrorPanel Message="@errorMessage" />

    @if (isLoading)
    {
        <SurfacePanel Title="Loading">
            <p class="muted-copy">Loading your game-specific player profiles.</p>
        </SurfacePanel>
    }
    else
    {
        <div class="content-grid">
            <div class="stack">
                <SurfacePanel Title="Create or update profile" Subtitle="Profiles are game-specific and can only be used for that game.">
                    <PlayerProfileForm Games="@games"
                                       GameId="@profileGameId"
                                       GameIdChanged="SetProfileGame"
                                       ProfileName="@profileName"
                                       ProfileNameChanged="SetProfileName"
                                       IsBusy="@isBusy"
                                       OnSubmit="SaveProfileAsync" />
                </SurfacePanel>
            </div>

            <div class="stack">
                <SurfacePanel Title="Your profiles">
                    <PlayerProfileList Profiles="@playerProfiles" EmptyState="Create a game-specific player profile to use it in team rosters." />
                </SurfacePanel>

                <PlayerProfileLogoList Profiles="@playerProfiles"
                                       IsBusy="@isBusy"
                                       LogoUploaded="SetProfileLogoAsync"
                                       LogoCleared="ClearProfileLogoAsync" />
            </div>
        </div>
    }
</section>
