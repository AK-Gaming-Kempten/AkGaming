@page "/discover"
@namespace AkGaming.Tournaments.Frontend.Components.General

<PageTitle>Discover Tournaments</PageTitle>

<section class="app-page">
    <PageHeader Title="Discover tournaments" />
    <ApiErrorPanel Message="@errorMessage" />

    @if (isLoading)
    {
        <p class="muted-copy">Loading tournaments.</p>
    }
    else
    {
        <div class="discover-grid">
            @foreach (var tournament in tournaments)
            {
                <TournamentCard Summary="@tournament" />
            }
        </div>
    }
</section>
