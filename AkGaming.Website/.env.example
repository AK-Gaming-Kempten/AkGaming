# CMS OIDC client registered in AkGaming.Identity.
AUTH_AKG_ISSUER=https://identity.akgaming.de
AUTH_AKG_CLIENT_ID=akgaming-website-cms
AUTH_AKG_CLIENT_SECRET=development-website-cms-client-secret

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# Optional for local development; Docker sets both under /var/lib/akgaming-website.
# Production must mount a persistent named volume or host directory at that path.
# AKG_WEBSITE_CONTENT_ROOT=/var/lib/akgaming-website/content
# AKG_WEBSITE_MEDIA_ROOT=/var/lib/akgaming-website/media
